def main():
    parser = argparse.ArgumentParser(description='DNA 无损图像压缩编码器')
    parser.add_argument('-i', '--image', required=True, help='输入图片路径')
    parser.add_argument('-m', '--model', required=True, help='基础Llama模型路径')
    parser.add_argument('-w', '--weights', required=True, help='IA3权重文件路径 (.bin)')
    parser.add_argument('-o', '--output', required=True, help='输出压缩文件路径 (.bin)')
    parser.add_argument('-p', '--prompt', default='instruction', 
                       choices=['no_prompt', 'channel', 'instruction'],
                       help='提示词类型 (默认: instruction)')
    parser.add_argument('--device', default='cuda', choices=['cuda', 'cpu'],
                       help='设备 (默认: cuda)')
    
    args = parser.parse_args()
    
    # 验证路径
    if not Path(args.image).exists():
        raise FileNotFoundError(f"图片不存在: {args.image}")
    if not Path(args.model).exists():
        raise FileNotFoundError(f"模型不存在: {args.model}")
    if not Path(args.weights).exists():
        raise FileNotFoundError(f"权重不存在: {args.weights}")
    
    # 创建编码器
    encoder = DNAEncoder(args.model, args.weights, args.prompt)
    
    # 压缩图像
    encoder.compress_image(args.image, args.output)
    
    print("压缩完成!")


if __name__ == "__main__":
    main()
