"""
# ============================================================================
# Elias Gamma Coding
# ============================================================================
#
# This implementation uses Elias gamma coding based on:
#
# P. Elias,
# "Universal Codeword Sets and Representations of the Integers,"
# IEEE Transactions on Information Theory,
# vol. 21, no. 2, pp. 194-203, 1975.
#
# DOI: 10.1109/TIT.1975.1055349
#
# NOTE:
# Pixel symbols are first ranked according to the probability distribution
# predicted by the autoregressive model. The resulting non-negative rank
# is then encoded using an Elias gamma code.
#
# This rank-based adaptation is specific to this image-compression pipeline.
# ============================================================================
python DNA_image_encoder_rank.py -i image.png -m /path/to/llama -w weights.bin -o output.bin -p instruction
"""

import torch
import torch.nn as nn
import torch.nn.functional as F
import numpy as np
from PIL import Image
import struct
import json
import argparse
from pathlib import Path
from typing import List, Tuple, Dict
from transformers import AutoModelForCausalLM, AutoTokenizer


# ============================================================================
# 配置
# ============================================================================

PATCH_SIZE = 16
PIXELS_PER_PATCH = PATCH_SIZE * PATCH_SIZE * 3  # 768


# ============================================================================
# INT8 量化器
# ============================================================================

class INT8Quantizer:
    """INT8对称量化"""
    
    @staticmethod
    def dequantize(data: np.ndarray, scale: float) -> np.ndarray:
        return data.astype(np.float32) * scale


# ============================================================================
# Elias Gamma 编码
# ============================================================================

class EliasGammaEncoder:
    """
    Elias Gamma 编码器
    
    对于非负整数 n >= 0:
    - n=0: 编码为 "1"
    - n>0: 先写 floor(log2(n+1)) 个 0，再写 (n+1) 的二进制
    
    编码长度:
    - rank=0: 1 bit
    - rank=1: 3 bits  
    - rank=2-3: 5 bits
    - rank=4-7: 7 bits
    - ...
    """
    
    def __init__(self):
        self.bits = []
    
    def encode(self, n: int):
        """编码一个非负整数"""
        if n < 0:
            raise ValueError(f"Elias Gamma 只支持非负整数，收到 {n}")
        
        # n=0 特殊处理
        if n == 0:
            self.bits.append(1)
            return
        
        # n >= 1: 编码 (n+1)
        val = n + 1
        num_bits = val.bit_length()
        
        # 写 (num_bits - 1) 个 0
        for _ in range(num_bits - 1):
            self.bits.append(0)
        
        # 写 val 的二进制 (num_bits 位)
        for i in range(num_bits - 1, -1, -1):
            self.bits.append((val >> i) & 1)
    
    def get_bits(self) -> List[int]:
        return self.bits
    
    def get_bytes(self) -> bytes:
        """将位流转换为字节（8位对齐）"""
        # 计算需要的 padding
        padding = (8 - len(self.bits) % 8) % 8
        padded_bits = self.bits + [0] * padding
        
        # 转换为字节
        result = bytearray()
        for i in range(0, len(padded_bits), 8):
            byte_val = 0
            for j in range(8):
                if padded_bits[i + j]:
                    byte_val |= (1 << (7 - j))
            result.append(byte_val)
        
        return bytes(result), padding


class EliasGammaDecoder:
    """Elias Gamma 解码器"""
    
    def __init__(self, bits: List[int]):
        self.bits = bits
        self.pos = 0
    
    def decode(self) -> int:
        """解码一个非负整数"""
        if self.pos >= len(self.bits):
            raise ValueError("位流结束")
        
        # 读取前导 0 的数量
        num_zeros = 0
        while self.pos < len(self.bits) and self.bits[self.pos] == 0:
            num_zeros += 1
            self.pos += 1
        
        # 如果没有前导 0，则值为 0
        if num_zeros == 0:
            self.pos += 1  # 跳过 '1'
            return 0
        
        # 读取 (num_zeros + 1) 位的二进制数
        num_bits = num_zeros + 1
        val = 0
        for _ in range(num_bits):
            if self.pos >= len(self.bits):
                raise ValueError("位流不完整")
            val = (val << 1) | self.bits[self.pos]
            self.pos += 1
        
        return val - 1
    
    def remaining(self) -> int:
        return len(self.bits) - self.pos


# ============================================================================
# Rank 编码器
# ============================================================================

def get_rank(probs: np.ndarray, symbol: int) -> int:
    """
    获取符号在概率排序中的位置（rank）
    
    Args:
        probs: 概率分布 (256,)
        symbol: 实际符号值 (0-255)
    
    Returns:
        rank: 符号在降序排序中的位置 (0 = 最高概率)
    """
    # 按概率降序排序，使用负索引作为第二排序键保证稳定性
    # 这样相同概率时，索引小的排在前面
    indices = np.lexsort((-np.arange(len(probs)), -probs))
    
    # 找到 symbol 在排序后的位置
    rank = np.where(indices == symbol)[0][0]
    return int(rank)


def get_symbol_from_rank(probs: np.ndarray, rank: int) -> int:
    """
    从 rank 恢复符号
    
    Args:
        probs: 概率分布 (256,)
        rank: 在降序排序中的位置
    
    Returns:
        symbol: 原始符号值 (0-255)
    """
    # 与 get_rank 使用完全相同的排序方式
    indices = np.lexsort((-np.arange(len(probs)), -probs))
    return int(indices[rank])


# ============================================================================
# IA3-Llama 模型
# ============================================================================

class IA3LlamaModel(nn.Module):
    """IA3-Llama模型"""
    
    def __init__(self, model_path: str, ia3_weights_path: str, device: str = "cuda"):
        super().__init__()
        self.model_path = model_path
        self.device = torch.device(device if torch.cuda.is_available() else "cpu")
        
        print(f"加载基础模型: {model_path}")
        self.model = AutoModelForCausalLM.from_pretrained(
            model_path,
            torch_dtype=torch.float16,
            device_map={"": self.device},
            trust_remote_code=True
        )
        
        config = self.model.config
        self.num_layers = config.num_hidden_layers
        self.hidden_dim = config.hidden_size
        self.intermediate_size = config.intermediate_size
        self.num_attention_heads = config.num_attention_heads
        self.num_key_value_heads = getattr(config, 'num_key_value_heads', self.num_attention_heads)
        self.head_dim = self.hidden_dim // self.num_attention_heads
        self.kv_dim = self.head_dim * self.num_key_value_heads
        
        for param in self.model.parameters():
            param.requires_grad = False
        
        self.ia3_parameters = {}
        
        print(f"加载IA3权重: {ia3_weights_path}")
        self._load_ia3_weights(ia3_weights_path)
        
        self.model.eval()
        print("模型初始化完成")
    
    def _load_ia3_weights(self, weights_path: str):
        weights_path = Path(weights_path)
        
        if self._try_load_self_contained_bin(weights_path):
            return
        
        base_path = weights_path.with_suffix('')
        metadata_path = f"{base_path}_metadata.json"
        
        if Path(metadata_path).exists():
            print("⚠ 检测到旧格式权重")
            self._load_legacy_format(base_path)
        else:
            raise FileNotFoundError(f"无法加载权重")
    
    def _try_load_self_contained_bin(self, bin_path: Path) -> bool:
        try:
            with open(bin_path, 'rb') as f:
                magic = struct.unpack('<I', f.read(4))[0]
                if magic != 0x49413333:
                    return False
                
                num_params = struct.unpack('<I', f.read(4))[0]
                expected_params = self.num_layers * 3
                
                if num_params != expected_params:
                    return False
                
                scales = []
                for _ in range(num_params):
                    scale = struct.unpack('<f', f.read(4))[0]
                    scales.append(scale)
                
                binary_data = f.read()
            
            param_idx = 0
            offset = 0
            
            for layer_idx in range(self.num_layers):
                for module_name in ["k_proj", "v_proj", "up_proj"]:
                    param_name = f"layer_{layer_idx}_{module_name}"
                    
                    if module_name in ["k_proj", "v_proj"]:
                        size = self.kv_dim
                    else:
                        size = self.intermediate_size
                    
                    chunk = binary_data[offset:offset + size]
                    q_data = np.frombuffer(chunk, dtype=np.int8)
                    offset += size
                    
                    scale = scales[param_idx]
                    fp_data = INT8Quantizer.dequantize(q_data, scale)
                    
                    param_tensor = torch.from_numpy(fp_data).to(
                        dtype=torch.float16,
                        device=self.device
                    )
                    
                    self.ia3_parameters[param_name] = param_tensor
                    param_idx += 1
            
            print(f"加载了 {len(self.ia3_parameters)} 个IA3参数")
            self._register_ia3_hooks()
            return True
            
        except Exception:
            return False
    
    def _load_legacy_format(self, base_path: Path):
        metadata_path = f"{base_path}_metadata.json"
        
        with open(metadata_path, 'r') as f:
            metadata = json.load(f)
        
        param_order = metadata['parameter_order']
        param_info = metadata['parameter_info']
        
        bin_path = f"{base_path}.bin"
        with open(bin_path, 'rb') as f:
            binary_data = f.read()
        
        offset = 0
        for param_name in param_order:
            info = param_info[param_name]
            shape = info['shape']
            size = info['size']
            scale = info['scale']
            
            chunk = binary_data[offset:offset + size]
            q_data = np.frombuffer(chunk, dtype=np.int8)
            offset += size
            
            fp_data = INT8Quantizer.dequantize(q_data, scale)
            fp_data = fp_data.reshape(shape)
            
            param_tensor = torch.from_numpy(fp_data).to(
                dtype=torch.float16,
                device=self.device
            )
            
            self.ia3_parameters[param_name] = param_tensor
        
        print(f"加载了 {len(self.ia3_parameters)} 个IA3参数")
        self._register_ia3_hooks()
    
    def _register_ia3_hooks(self):
        for layer_idx, layer in enumerate(self.model.model.layers):
            for module_name in ["k_proj", "v_proj", "up_proj"]:
                param_name = f"layer_{layer_idx}_{module_name}"
                
                if param_name not in self.ia3_parameters:
                    continue
                
                if module_name == "k_proj":
                    target_module = layer.self_attn.k_proj
                elif module_name == "v_proj":
                    target_module = layer.self_attn.v_proj
                elif module_name == "up_proj":
                    target_module = layer.mlp.up_proj
                
                ia3_param = self.ia3_parameters[param_name]
                
                def make_hook(param):
                    def hook(module, input, output):
                        return output * param
                    return hook
                
                target_module.register_forward_hook(make_hook(ia3_param))
    
    def forward(self, input_ids, attention_mask=None):
        return self.model(input_ids=input_ids, attention_mask=attention_mask)


# ============================================================================
# DNA 压缩编码器 (Rank 版本)
# ============================================================================

class DNAEncoder:
    """DNA无损图像压缩编码器（Rank编码版本）"""
    
    def __init__(self, model_path: str, ia3_weights_path: str, prompt_type: str = "instruction"):
        print("="*70)
        print("DNA 无损图像压缩编码器 (Rank 编码版本)")
        print("="*70)
        print(f"Prompt类型: {prompt_type}")
        print("编码方式: Rank + Elias Gamma")
        
        self.model = IA3LlamaModel(model_path, ia3_weights_path)
        self.prompt_type = prompt_type
        
        print(f"加载tokenizer: {model_path}")
        self.tokenizer = AutoTokenizer.from_pretrained(
            model_path, 
            trust_remote_code=True,
            use_fast=True
        )
        if self.tokenizer.pad_token is None:
            self.tokenizer.pad_token = self.tokenizer.eos_token
            self.tokenizer.pad_token_id = self.tokenizer.eos_token_id
        if self.tokenizer.bos_token_id is None:
            self.tokenizer.bos_token_id = 128000
        
        print("构建数字词表...")
        self.digital_dict = {}
        self.reverse_dict = {}
        for i in range(256):
            tokens = self.tokenizer.encode(str(i), add_special_tokens=False)
            if len(tokens) != 1:
                raise ValueError(f"数字 {i} 映射到 {len(tokens)} 个tokens")
            token_id = tokens[0]
            self.digital_dict[i] = token_id
            self.reverse_dict[token_id] = i
        
        print(f"词表构建完成: 0-255 → {len(self.digital_dict)} tokens")
        print("编码器初始化完成\n")
    
    def generate_prompt_tokens(self, x: int, y: int, img_width: int, img_height: int) -> List[int]:
        if self.prompt_type == "no_prompt":
            return [self.tokenizer.bos_token_id]
        elif self.prompt_type == "channel":
            prompt = "Every triplet denote an RGB pixel of a 2D image. Predict the next RGB pixel based on the previous pixels."
            return [self.tokenizer.bos_token_id] + self.tokenizer.encode(prompt, add_special_tokens=False)
        else:
            prompt = f"At position ({x:04d}, {y:04d}) begins a sequence where every triplet denotes an RGB pixel of a 2D image. Predict the next RGB pixel based on the previous pixels."
            return [self.tokenizer.bos_token_id] + self.tokenizer.encode(prompt, add_special_tokens=False)
    
    def get_pixel_probability(self, context_tokens: List[int]) -> np.ndarray:
        device = self.model.device
        context = torch.tensor(context_tokens, dtype=torch.long).unsqueeze(0).to(device)
        
        with torch.no_grad():
            outputs = self.model(context)
            logits = outputs.logits[0, -1, :]
            full_probs = torch.softmax(logits, dim=0)
            
            pixel_probs = torch.zeros(256, device=device, dtype=torch.float32)
            for pixel_val in range(256):
                token_id = self.digital_dict[pixel_val]
                pixel_probs[pixel_val] = full_probs[token_id]
        
        return pixel_probs.cpu().numpy()
    
    def compress_patch(self, patch_pixels: np.ndarray, x: int, y: int, 
                      img_width: int, img_height: int) -> Tuple[bytes, int, List[int]]:
        """
        压缩一个patch (使用 Rank + Elias Gamma)
        
        正向编码：不需要像 rANS 那样反向
        
        Returns:
            (compressed_bytes, padding_bits, ranks): 压缩字节、padding位数、rank列表（用于统计）
        """
        encoder = EliasGammaEncoder()
        
        # 生成提示词tokens
        prompt_tokens = self.generate_prompt_tokens(x, y, img_width, img_height)
        context_tokens = prompt_tokens.copy()
        
        ranks = []
        
        # 正向逐像素编码
        for pixel_val in patch_pixels:
            pixel_val = int(pixel_val)
            
            # 获取概率分布
            prob_dist = self.get_pixel_probability(context_tokens)
            
            # 计算 rank
            rank = get_rank(prob_dist, pixel_val)
            ranks.append(rank)
            
            # Elias Gamma 编码
            encoder.encode(rank)
            
            # 更新context
            pixel_token = self.digital_dict[pixel_val]
            context_tokens.append(pixel_token)
        
        # 获取压缩结果
        compressed_bytes, padding = encoder.get_bytes()
        
        return compressed_bytes, padding, ranks
    
    def compress_image(self, image_path: str, output_path: str):
        """压缩完整图像"""
        print(f"加载图像: {image_path}")
        img = Image.open(image_path).convert('RGB')
        img_array = np.array(img)
        original_h, original_w, c = img_array.shape
        
        padded_h = ((original_h + PATCH_SIZE - 1) // PATCH_SIZE) * PATCH_SIZE
        padded_w = ((original_w + PATCH_SIZE - 1) // PATCH_SIZE) * PATCH_SIZE
        
        if padded_h != original_h or padded_w != original_w:
            padded_array = np.zeros((padded_h, padded_w, c), dtype=np.uint8)
            padded_array[:original_h, :original_w, :] = img_array
            img_array = padded_array
            print(f"图像尺寸: {original_h}x{original_w} → Padding至 {padded_h}x{padded_w}")
        else:
            print(f"图像尺寸: {original_h}x{original_w}")
        
        n_h = padded_h // PATCH_SIZE
        n_w = padded_w // PATCH_SIZE
        num_patches = n_h * n_w
        
        print(f"Patches: {n_h}x{n_w} = {num_patches}")
        print(f"\n开始压缩 (Rank + Elias Gamma)...\n")
        
        # 压缩所有patches
        all_patch_bytes = []
        all_patch_paddings = []
        all_ranks = []
        
        for patch_idx in range(num_patches):
            i = patch_idx // n_w
            j = patch_idx % n_w
            x = j * PATCH_SIZE
            y = i * PATCH_SIZE
            
            print(f"Patch [{i},{j}] (第{patch_idx+1}/{num_patches}个)", end=" ")
            
            patch = img_array[
                i*PATCH_SIZE:(i+1)*PATCH_SIZE,
                j*PATCH_SIZE:(j+1)*PATCH_SIZE,
                :
            ]
            flat_patch = patch.flatten()
            
            compressed_bytes, padding, ranks = self.compress_patch(flat_patch, x, y, padded_w, padded_h)
            all_patch_bytes.append(compressed_bytes)
            all_patch_paddings.append(padding)
            all_ranks.extend(ranks)
            
            # 统计
            total_bits = len(compressed_bytes) * 8 - padding
            bits_per_token = total_bits / PIXELS_PER_PATCH
            avg_rank = np.mean(ranks)
            print(f"→ {len(compressed_bytes)} bytes, {bits_per_token:.2f} bits/token, avg_rank={avg_rank:.1f}")
        
        # 保存
        self._save_compressed_file(
            output_path,
            original_w, original_h,
            padded_w, padded_h,
            all_patch_bytes,
            all_patch_paddings
        )
        
        # 统计
        self._print_statistics(original_w, original_h, all_patch_bytes, all_patch_paddings, all_ranks, output_path)
    
    def _save_compressed_file(self, output_path: str,
                             original_width: int, original_height: int,
                             padded_width: int, padded_height: int,
                             all_patch_bytes: List[bytes],
                             all_patch_paddings: List[int]):
        """
        保存压缩文件 (Rank 格式)
        
        格式:
            [Header]
            - magic: 4 bytes (0x524B4E31 = 'RKN1')
            - original_width: 4 bytes
            - original_height: 4 bytes
            - padded_width: 4 bytes
            - padded_height: 4 bytes
            - num_patches: 4 bytes
            
            [Patch Info] - 每个patch
            - byte_length: 4 bytes
            - padding_bits: 1 byte
            
            [Compressed Data]
            - 所有patch的压缩字节
        """
        output_path = Path(output_path)
        output_path.parent.mkdir(parents=True, exist_ok=True)
        
        num_patches = len(all_patch_bytes)
        
        with open(output_path, 'wb') as f:
            # Header
            f.write(struct.pack('<I', 0x524B4E31))  # 'RKN1' magic
            f.write(struct.pack('<IIIII',
                                original_width, original_height,
                                padded_width, padded_height,
                                num_patches))
            
            # Patch Info
            for patch_bytes, padding in zip(all_patch_bytes, all_patch_paddings):
                f.write(struct.pack('<IB', len(patch_bytes), padding))
            
            # Compressed Data
            for patch_bytes in all_patch_bytes:
                f.write(patch_bytes)
        
        print(f"\n压缩文件已保存: {output_path}")
    
    def _print_statistics(self, width: int, height: int,
                         all_patch_bytes: List[bytes],
                         all_patch_paddings: List[int],
                         all_ranks: List[int],
                         output_path: str):
        """打印压缩统计"""
        original_bytes = width * height * 3
        
        total_bits = sum(len(b) * 8 - p for b, p in zip(all_patch_bytes, all_patch_paddings))
        compressed_bytes = Path(output_path).stat().st_size
        
        compression_ratio = original_bytes / compressed_bytes
        bpp = (compressed_bytes * 8) / (width * height)
        bps = bpp / 3
        
        num_patches = len(all_patch_bytes)
        avg_bits_per_token = total_bits / (num_patches * PIXELS_PER_PATCH)
        
        # Rank 统计
        ranks_array = np.array(all_ranks)
        avg_rank = np.mean(ranks_array)
        median_rank = np.median(ranks_array)
        rank_0_ratio = np.sum(ranks_array == 0) / len(ranks_array) * 100
        rank_top5_ratio = np.sum(ranks_array < 5) / len(ranks_array) * 100
        
        print(f"\n{'='*70}")
        print(f"压缩统计 (Rank + Elias Gamma)")
        print(f"{'='*70}")
        print(f"原始大小:        {original_bytes:>12,} bytes")
        print(f"压缩数据:        {total_bits:>12,} bits ({total_bits/8:,.0f} bytes)")
        print(f"文件大小:        {compressed_bytes:>12,} bytes")
        print(f"压缩率:          {compression_ratio:>12.2f}x")
        print(f"每像素比特:      {bpp:>12.3f}")
        print(f"每子像素比特:    {bps:>12.3f}")
        print(f"平均bits/token:  {avg_bits_per_token:>12.3f}")
        print(f"{'='*70}")
        print(f"Rank 统计:")
        print(f"  平均 rank:     {avg_rank:>12.2f}")
        print(f"  中位 rank:     {median_rank:>12.1f}")
        print(f"  rank=0 比例:   {rank_0_ratio:>12.1f}%  (模型预测正确)")
        print(f"  rank<5 比例:   {rank_top5_ratio:>12.1f}%  (Top-5 准确)")
        print(f"{'='*70}\n")


# ============================================================================
# 主程序
# ============================================================================

def main():
    parser = argparse.ArgumentParser(description='DNA 无损图像压缩编码器 (Rank 版本)')
    parser.add_argument('-i', '--image', required=True, help='输入图片路径')
    parser.add_argument('-m', '--model', required=True, help='基础Llama模型路径')
    parser.add_argument('-w', '--weights', required=True, help='IA3权重文件路径')
    parser.add_argument('-o', '--output', required=True, help='输出压缩文件路径')
    parser.add_argument('-p', '--prompt', default='instruction',
                       choices=['no_prompt', 'channel', 'instruction'],
                       help='提示词类型')
    
    args = parser.parse_args()
    
    if not Path(args.image).exists():
        raise FileNotFoundError(f"图片不存在: {args.image}")
    if not Path(args.model).exists():
        raise FileNotFoundError(f"模型不存在: {args.model}")
    if not Path(args.weights).exists():
        raise FileNotFoundError(f"权重不存在: {args.weights}")
    
    encoder = DNAEncoder(args.model, args.weights, args.prompt)
    encoder.compress_image(args.image, args.output)
    
    print("压缩完成!")


if __name__ == "__main__":
    main()
