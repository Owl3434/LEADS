def analyse_recovery_by_type(final_payloads, indices, ec_table, params,
                              ref_entries, outdir, primer_label=""):
    """
    v5.1: 输入改为 ref_entries (encoder fasta entries).
    类型直接来自 fasta header (避免 csv 顺序被打乱的问题).

    输入:
      final_payloads: dict[(bid, iid)] -> {'payload': ..., ...}
      params:         encoder params (用于 Coredata/Metadata 细分)
      ref_entries:    list of dict from load_encoder_fasta
      primer_label:   用于输出文件命名
    """
    print(f"\n[Step 5] 按数据类型统计恢复率 (v5.1: 类型来自 encoder fasta header)")

    coredata_len = int(params.get('coredata_length', 0))
    metadata_len = int(params.get('metadata_length', 0))
    padding_len = int(params.get('padding_length', 0))
    payload_len_param = int(params.get('payload_length', 124))

    # 期望数从 fasta entries 统计
    expected_main = sum(1 for e in ref_entries if e['type'] == 'main')
    expected_meta_a = sum(1 for e in ref_entries if e['type'] == 'meta_a')
    expected_meta_b = sum(1 for e in ref_entries if e['type'] == 'meta_b')
    total_expected = len(ref_entries)
    main_count = expected_main

    print(f"  数据结构 (来自 encoder fasta):")
    print(f"    Main (Coredata+Metadata): {expected_main:,} 条")
    print(f"      Coredata: {coredata_len:,} nt")
    print(f"      Metadata: {metadata_len:,} nt")
    print(f"      Padding:  {padding_len} nt")
    if expected_meta_a > 0:
        print(f"    Meta-A: {expected_meta_a} 条")
    if expected_meta_b > 0:
        print(f"    Meta-B: {expected_meta_b} 条")
    print(f"    总计: {total_expected:,} 条")

    # 从 fasta entries 提取 addr → (payload_idx, ref_payload, type)
    addr_to_ref = {}  # (bid, iid) → (payload_idx, ref_payload, fasta_type)

    for entry in ref_entries:
        seq = entry['oligo']
        if len(seq) < 162:
            continue
        bid = entry['block_id']
        iid = entry['inblock_id']
        ref_payload = seq[38:162]
        addr = (bid, iid)
        if addr not in addr_to_ref:
            addr_to_ref[addr] = (entry['payload_idx'], ref_payload, entry['type'])

    print(f"  参考地址映射: {len(addr_to_ref):,} 条")
    ref_addrs = set(addr_to_ref.keys())

    type_stats = {
        'main':    {'expected': expected_main,   'confirmed': 0, 'hash_ok_but_mismatch': 0, 'any_payload': 0},
        'meta_a':  {'expected': expected_meta_a, 'confirmed': 0, 'hash_ok_but_mismatch': 0, 'any_payload': 0},
        'meta_b':  {'expected': expected_meta_b, 'confirmed': 0, 'hash_ok_but_mismatch': 0, 'any_payload': 0},
        'other':   {'expected': 0,               'confirmed': 0, 'hash_ok_but_mismatch': 0, 'any_payload': 0},
    }

    coredata_payloads = (coredata_len + payload_len_param - 1) // payload_len_param if coredata_len > 0 else 0
    core_confirmed = 0
    meta_in_main_confirmed = 0

    for addr, info in final_payloads.items():
        best_payload = info['payload']

        if addr not in ref_addrs:
            type_stats['other']['any_payload'] += 1
            type_stats['other']['hash_ok_but_mismatch'] += 1
            continue

        pidx, ref_payload, fasta_type = addr_to_ref[addr]
        dtype = fasta_type   # 直接用 fasta type, 不再 get_type 推断

        type_stats[dtype]['any_payload'] += 1

        if best_payload == ref_payload:
            type_stats[dtype]['confirmed'] += 1
            if dtype == 'main':
                if pidx < coredata_payloads:
                    core_confirmed += 1
                else:
                    meta_in_main_confirmed += 1
        else:
            type_stats[dtype]['hash_ok_but_mismatch'] += 1

    # 打印
    print(f"\n  ★ 分类恢复率 (Hash通过 + Payload与参考一致)")
    print(f"  {'类型':<12} {'期望':>8} {'确认恢复':>10} {'恢复率':>9} {'Hash≠ref':>10} {'有payload':>10}")
    print(f"  {'-'*62}")

    total_exp = 0
    total_confirmed = 0

    for dtype in ['main', 'meta_a', 'meta_b']:
        s = type_stats[dtype]
        if s['expected'] == 0:
            continue
        exp = s['expected']
        conf = s['confirmed']
        mismatch = s['hash_ok_but_mismatch']
        anyp = s['any_payload']
        pct = conf / max(exp, 1) * 100

        label = {'main': 'Main', 'meta_a': 'Meta-A', 'meta_b': 'Meta-B'}[dtype]
        print(f"  {label:<12} {exp:>8,} {conf:>10,} {pct:>8.2f}% {mismatch:>10,} {anyp:>10,}")

        total_exp += exp
        total_confirmed += conf

    print(f"  {'-'*62}")
    total_pct = total_confirmed / max(total_exp, 1) * 100
    print(f"  {'总计':<12} {total_exp:>8,} {total_confirmed:>10,} {total_pct:>8.2f}%")

    # 其他库
    s_other = type_stats['other']
    if s_other['any_payload'] > 0:
        print(f"\n  其他库 (地址不在本参考表中):")
        print(f"    找到地址: {s_other['any_payload']:,}, 其中Hash通过: {s_other['hash_ok_but_mismatch']:,}")

    # 地址冲突统计
    total_mismatch = sum(s['hash_ok_but_mismatch'] for s in type_stats.values()
                        if s is not type_stats['other'])
    if total_mismatch > 0:
        print(f"\n  地址冲突 (Hash通过但payload与本库参考不一致): {total_mismatch:,}")
        print(f"  这些可能是其他库使用了相同地址的 oligo")

    # Main 细分
    if coredata_payloads > 0 and main_count > 0:
        metadata_payloads = main_count - coredata_payloads
        print(f"\n  ★ Main 细分 (确认恢复)")
        print(f"    Coredata payloads: {coredata_payloads:,}, "
              f"恢复 {core_confirmed:,} ({core_confirmed/max(coredata_payloads,1)*100:.2f}%)")
        print(f"    Metadata payloads: {metadata_payloads:,}, "
              f"恢复 {meta_in_main_confirmed:,} ({meta_in_main_confirmed/max(metadata_payloads,1)*100:.2f}%)")

    # 输出明细 TSV
    primer_tag = (primer_label or params.get('forward_primer', 'unknown'))[:10]
    type_path = os.path.join(outdir, f'recovery_by_type_{primer_tag}.tsv')
    with open(type_path, 'w', newline='') as f:
        w = csv.writer(f, delimiter='\t')
        w.writerow(['type', 'expected', 'confirmed', 'confirmed_pct',
                    'hash_ok_mismatch', 'any_payload'])
        for dtype in ['main', 'meta_a', 'meta_b', 'other']:
            s = type_stats[dtype]
            exp = s['expected']
            conf = s['confirmed']
            pct = conf / max(exp, 1) * 100 if exp > 0 else 0
            w.writerow([dtype, exp, conf, f"{pct:.4f}",
                        s['hash_ok_but_mismatch'], s['any_payload']])
        # 总计行
        w.writerow(['_total', total_exp, total_confirmed,
                    f"{total_pct:.4f}",
                    total_mismatch, sum(s['any_payload'] for s in type_stats.values())])
        # Main 细分
        if coredata_payloads > 0 and main_count > 0:
            metadata_payloads = main_count - coredata_payloads
            core_pct = core_confirmed / max(coredata_payloads, 1) * 100
            mm_pct = meta_in_main_confirmed / max(metadata_payloads, 1) * 100
            w.writerow(['_core', coredata_payloads, core_confirmed,
                        f"{core_pct:.4f}", '-', '-'])
            w.writerow(['_meta_in_main', metadata_payloads, meta_in_main_confirmed,
                        f"{mm_pct:.4f}", '-', '-'])

    print(f"\n  分类明细: {type_path}")

    return type_stats



# =============================================================================
# Params 文件读取
# =============================================================================

def load_params_file(params_path):
    """读取 encoder 输出的参数文件, 返回 dict."""
    params = {}
    with open(params_path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' in line:
                key, value = line.split('=', 1)
                params[key.strip()] = value.strip()
    return params


# =============================================================================
# 主程序
# =============================================================================

def main():
    parser = argparse.ArgumentParser(
        description='DNA Storage Recovery v5 — 4 元组多数投票 + K 阈值过滤',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
设计:
  v5 删除 CAPMB / 聚类, 改用 4 元组 (read_block, read_inblock, read_payload,
  read_hash) 完全相同的多数投票. 每个 (bid, iid) 桶取频次最高的 4 元组作为
  winner, 频次 = coverage. 只有 coverage >= K (默认 2) 的桶被接受.

  K=2 意为 "至少要看到 2 条完全一样的 read 才信", 是 PCR 复制 / 合成产物
  的自我证实门槛, 能消除单条孤立 hash-pass 引入的 silent corruption.

恢复层与评估层严格分离:
  - 恢复层: 只输出主导库中 K 阈值通过的 (bid, iid, payload). 不看总表.
  - 评估层 (需 --oligo-table): 用总表统计未恢复 + 错误进入两类事件,
    Step 5 给 Main / Meta-A / Meta-B + Coredata / Metadata 细分.

示例:
  python dna_recovery_v5.py \\
      --merged merged.fastq \\
      --params Cat/output_params.txt Abstract/output_params.txt Pool/output_params.txt \\
      --oligo-table S99989142new.csv \\
      -o recovery_v5
  # 默认 K=2, max_block_id=200

  # 调整 K (更严格 = 更少错入但更多缺失)
  python dna_recovery_v5.py ... --min-coverage 3 -o recovery_v5_k3
''')
    parser.add_argument('-r1', '--read1', default=None, help='R1 FASTQ (.fq.gz)')
    parser.add_argument('-r2', '--read2', default=None, help='R2 FASTQ (.fq.gz)')
    parser.add_argument('--merged', default=None,
                        help='已合并的 FASTQ (跳过 PEAR)')
    parser.add_argument('--params', default=None, nargs='+',
                        help='Encoder 参数文件, 可一次给多个 (用于提取所有 primer 候选 + 评估)')
    parser.add_argument('-p', '--primers', default=None, nargs='+',
                        help='前引物列表 (可选). 不提供则从 --params 提取.')
    parser.add_argument('--seed', type=int, default=None)
    parser.add_argument('--num-indices', type=int, default=None)
    parser.add_argument('--min-overlap', type=int, default=80,
                        help='PEAR 最小重叠长度 (默认 80)')
    parser.add_argument('--threads', type=int, default=4,
                        help='PEAR 并行线程数 (默认 4)')
    parser.add_argument('--oligo-table', default=None,
                        help='[已废弃, 请用 --encoder-fasta] 参考 oligo 总表 CSV. '
                             'CSV 顺序可能被合成商打乱, 不能正确反推 payload_idx.')
    parser.add_argument('--encoder-fasta', default=None,
                        help='主导库的 encoder 原始输出 fasta (启用评估层). '
                             'fasta header 含真实 payload_idx + type. '
                             '示例: /data/hjwu/DNA_index/Results_Abstract/output.fasta')
    parser.add_argument('--max-block-id', type=int, default=200,
                        help='block_id 上限 (默认 200). bid >= 此值的 reads 直接丢弃, '
                             '消除 1bp 纠错过度引发的"幻影地址"错误进入.')
    parser.add_argument('--no-block-id-limit', action='store_true',
                        help='关闭 max_block_id 过滤.')
    parser.add_argument('-K', '--min-coverage', type=int, default=2,
                        help='K 阈值 (默认 2). winner 4 元组的频次 < K 的桶丢弃. '
                             'K=2 意为至少要看到 2 条完全相同的 read 才信任 winner. '
                             'K 越大 -> 错入越少 + 缺失越多. K=1 等于无过滤 (不推荐).')
    parser.add_argument('-o', '--outdir', default='recovery_v5')
    args = parser.parse_args()

    # --- 加载 params 文件 ---
    all_params = []
    if args.params:
        for pf in args.params:
            print(f"[读取参数文件] {pf}")
            p = load_params_file(pf)
            p['_path'] = pf
            dirname = os.path.basename(os.path.dirname(os.path.abspath(pf)))
            p['_label'] = p.get('forward_primer', dirname)[:20]
            all_params.append(p)
            print(f"  seed={p.get('seed')}, indices={p.get('num_indices')}, "
                  f"primer={p.get('forward_primer','?')[:20]}, "
                  f"oligos={p.get('oligo_count','?')}")

        first = all_params[0]
        if args.seed is None and 'seed' in first:
            args.seed = int(first['seed'])
        if args.num_indices is None and 'num_indices' in first:
            args.num_indices = int(first['num_indices'])

    # 默认值
    if args.seed is None:
        args.seed = DEFAULT_SEED
    if args.num_indices is None:
        args.num_indices = 500

    # --- 确定 primers 列表 + primer_tails ---
    if args.primers:
        primers = [p.upper() for p in args.primers]
    elif all_params:
        primers = []
        for p in all_params:
            fp = p.get('forward_primer')
            if fp and fp.upper() not in primers:
                primers.append(fp.upper())
        if not primers:
            primers = ['TGTGTTCCTCCTCGGTATGA']
    else:
        primers = ['TGTGTTCCTCCTCGGTATGA']

    bad = [p for p in primers if len(p) != PRIMER_LENGTH]
    if bad:
        print(f"错误: 以下 primer 长度不是 {PRIMER_LENGTH} bp: {bad}")
        sys.exit(1)

    if args.merged is None and (args.read1 is None or args.read2 is None):
        print("错误: 需要 -r1 + -r2, 或 --merged")
        sys.exit(1)

    if args.min_coverage < 1:
        print(f"错误: --min-coverage 必须 >= 1")
        sys.exit(1)

    print("\n" + "=" * 65)
    print("  DNA Storage Recovery v5")
    print(f"  4 元组多数投票 + K={args.min_coverage} 阈值过滤")
    print("=" * 65)

    os.makedirs(args.outdir, exist_ok=True)

    # primer_tails (启动时打印 hamming 验证)
    primer_tails = compute_primer_tails(primers, n=PRIMER_TAIL_N)
    n_primers = len(primers)

    # --- Index 码本 ---
    print(f"\n[Index 码本] seed={args.seed}, n={args.num_indices}")
    indices = generate_orthogonal_indices(args.num_indices, args.seed)
    print(f"  生成 {len(indices)} 个 index")
    ec_table = build_error_correction_table(indices)
    n_exact = len(indices)
    n_1bp = len(ec_table) - n_exact
    print(f"  纠错表: {len(ec_table):,} 条 (精确 {n_exact}, 1bp纠错 {n_1bp})")

    # --- Step 1: 合并 ---
    if args.merged:
        print(f"\n[Step 1] 使用已合并的 FASTQ: {args.merged}")
        merged_path = args.merged
    else:
        print(f"\n[Step 1] PEAR 合并")
        merged_path, n_merged = run_pear_merge(
            args.read1, args.read2, args.outdir,
            min_overlap=args.min_overlap, threads=args.threads)

    # --- Step 2: 4 元组分组计数 ---
    effective_max_bid = None if args.no_block_id_limit else args.max_block_id
    stats, bucket_counter = process_merged_reads(
        merged_path, indices, ec_table, primer_tails,
        max_block_id=effective_max_bid)

    # --- 选主导库 ---
    print(f"\n[选主导库]")
    if effective_max_bid is not None:
        print(f"  (注: bid >= {effective_max_bid} 已被过滤掉 "
              f"{stats['bid_filtered']:,} 条 reads)")
    print(f"  primer_id 分布 (按 reads 数):")
    dominant_pid, primer_dist = select_dominant_primer(stats, primers)
    for pid, cnt in primer_dist:
        cnt_h = stats['primer_id_dist_hashpass'].get(pid, 0)
        pct = cnt / max(stats['id_found'], 1) * 100
        mark = "  ← 主导库" if pid == dominant_pid else ""
        print(f"    #{pid} ({primers[pid][:20]}): {cnt:,} ({pct:.1f}%)  "
              f"hash 通过 {cnt_h:,}{mark}")
    dominant_primer = primers[dominant_pid]
    print(f"\n  ★ 主导库 = primer_id {dominant_pid} ({dominant_primer})")

    # --- Step 3: 应用 K 阈值, 输出产物 ---
    final_payloads, n_below_k, n_other_buckets, coverage_dist = apply_k_threshold(
        bucket_counter, dominant_pid, args.min_coverage)

    total_ok = write_outputs(
        args.outdir, stats, final_payloads, indices, dominant_pid,
        primers, args.min_coverage, n_below_k, n_other_buckets, coverage_dist)

    # --- Step 4 & 5: 评估 ---
    if args.encoder_fasta:
        # 找主导库对应的 params (用于 Coredata/Metadata 细分)
        dominant_params = None
        for p in all_params:
            if p.get('forward_primer', '').upper() == dominant_primer:
                dominant_params = p
                break

        # v5.1: 用 encoder fasta 替代 csv
        ref_entries = load_encoder_fasta(args.encoder_fasta)

        # 验证: fasta 里的 forward_primer 应与主导库一致
        if ref_entries:
            sample_oligo = ref_entries[0]['oligo']
            fasta_fwd = sample_oligo[:20]
            if fasta_fwd != dominant_primer:
                print(f"\n  encoder_fasta 的 forward_primer ({fasta_fwd}) "
                      f"与主导库 ({dominant_primer}) 不一致! 请确认 fasta 路径正确")

        # Step 4: 错误进入两类核心评估
        evaluate_dominant_library(
            final_payloads, indices, ec_table, ref_entries,
            args.outdir, dominant_pid, primer_label=dominant_primer,
            params=dominant_params)

        # Step 5: v3 风格的详细分类表
        if dominant_params:
            analyse_recovery_by_type(
                final_payloads, indices, ec_table, dominant_params,
                ref_entries, args.outdir, primer_label=dominant_primer)
    elif args.oligo_table:
        print("\n  --oligo-table 已废弃 (csv 顺序可能被打乱). 请改用 --encoder-fasta")
    else:
        print("\n  提示: 加 --encoder-fasta 参数可启用评估层")

    print(f"\n{'='*65}")
    print(f"  完成! 主导库 K={args.min_coverage} 阈值通过: {total_ok:,} 条 payload")
    print(f"  输出: {args.outdir}/")
    print(f"{'='*65}")


if __name__ == "__main__":
    main()
