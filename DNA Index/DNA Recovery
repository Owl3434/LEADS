import gzip
import subprocess
import sys
import os
import csv
import random
import shutil
from collections import defaultdict, Counter
from itertools import product as itertools_product
from typing import List, Tuple, Optional, Dict


# =============================================================================
# 常量 (与 encoder 一致)
# =============================================================================
INDEX_LENGTH = 9
PAYLOAD_LENGTH = 124
HASH_LENGTH = 8
PRIMER_LENGTH = 20
OLIGO_LENGTH = 190

BASES = ['A', 'T', 'G', 'C']
MIN_GC = 0.40
MAX_GC = 0.60
OPTIMAL_GC = 0.50
MAX_HOMOPOLYMER = 3
MIN_HAMMING_DISTANCE = 3
DEFAULT_SEED = 20241222

# Oligo 字段在序列上的绝对位置 (从 Block ID 锚点推算)
POS_BLOCK_ID   = (20, 29)
POS_INBLOCK_ID = (29, 38)
POS_PAYLOAD    = (38, 162)
POS_HASH       = (162, 170)


# =============================================================================
# 基础函数 (与 encoder 一致)
# =============================================================================

def gc_content(seq):
    if len(seq) == 0:
        return 0
    return sum(1 for b in seq if b in 'GC') / len(seq)

def gc_score(seq):
    return 1.0 - abs(gc_content(seq) - OPTIMAL_GC) * 2

def has_homopolymer(seq, max_len):
    for base in BASES:
        if base * (max_len + 1) in seq:
            return True
    return False

def count_max_homopolymer(seq):
    if len(seq) == 0:
        return 0
    max_len = current = 1
    for i in range(1, len(seq)):
        if seq[i] == seq[i-1]:
            current += 1
            max_len = max(max_len, current)
        else:
            current = 1
    return max_len

def hamming_distance(seq1, seq2):
    return sum(c1 != c2 for c1, c2 in zip(seq1, seq2))


# =============================================================================
# Primer 归属 (v3 新增)
# =============================================================================

PRIMER_TAIL_N = 10  # 锚点前用多少 bp 与 primer 尾部比对

def compute_primer_tails(primers, n=PRIMER_TAIL_N):
    """
    取每个 primer 的尾部 n bp.
    打印 primer 之间各种长度尾部的最小 hamming, 给出可区分性提示.
    """
    tails = [p[-n:] for p in primers]
    if len(primers) >= 2:
        print(f"\n[Primer 归属设置] N = {n} bp (锚点前)")
        for i, p in enumerate(primers):
            print(f"  primer #{i}: {p}   (尾 {n}bp: {p[-n:]})")
        # 打印两两 hamming
        print(f"  两两 hamming (尾 {n}bp):")
        min_d = n
        for i in range(len(primers)):
            for j in range(i+1, len(primers)):
                d = hamming_distance(tails[i], tails[j])
                print(f"    #{i} vs #{j}: {d}")
                min_d = min(min_d, d)
        print(f"  最小 hamming: {min_d}  "
              f"(原则上 >=3 即可区分, 越大越稳)")
        if min_d < 3:
            print(f" 警告: 最小 hamming < 3, primer 区分性较差")
    return tails


def assign_primer_id(seq, anchor_pos, primer_tails, n=PRIMER_TAIL_N):
    """
    基于锚点前 N bp 与 primer 尾部的 hamming 距离,
    返回最近邻的 primer_id (0..len(primer_tails)-1).

    规则 (按用户确认):
      - 永远归属一个 primer (前引物必然来自这三个之一, 选最相似的)
      - 不足 N bp 时按可比部分选最近邻
      - 锚点 P=0 (实在没法比) 退化为 primer_id=0
    """
    n_avail = min(anchor_pos, n)
    if n_avail <= 0:
        return 0  # 没法比, 默认归到第一个 (极少发生)
    obs = seq[anchor_pos - n_avail : anchor_pos]
    # 与每个 primer 的尾部 n_avail bp 比对
    distances = [hamming_distance(obs, t[-n_avail:]) for t in primer_tails]
    # 最小距离的 index (有并列时取最小 index)
    return min(range(len(distances)), key=lambda i: distances[i])


def reverse_complement(seq):
    comp = {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G', 'N': 'N'}
    return ''.join(comp.get(b, 'N') for b in reversed(seq))

def is_valid_index(seq):
    gc = gc_content(seq)
    return MIN_GC <= gc <= MAX_GC and not has_homopolymer(seq, MAX_HOMOPOLYMER)

def calculate_index_score(seq):
    return gc_score(seq) * 0.6 + (1.0 - (count_max_homopolymer(seq) - 1) / MAX_HOMOPOLYMER) * 0.4


# =============================================================================
# Index 生成 (与 encoder 完全一致)
# =============================================================================

def generate_orthogonal_indices(count, seed):
    random.seed(seed)
    candidates = []
    attempts = 0
    max_attempts = count * 100
    while len(candidates) < count * 10 and attempts < max_attempts:
        attempts += 1
        seq = ''.join(random.choice(BASES) for _ in range(INDEX_LENGTH))
        if is_valid_index(seq):
            candidates.append((seq, calculate_index_score(seq)))
    candidates.sort(key=lambda x: -x[1])

    indices = []
    for seq, score in candidates:
        if len(indices) >= count:
            break
        if not indices:
            min_dist = INDEX_LENGTH
        else:
            min_dist = min(
                min(hamming_distance(seq, e) for e in indices),
                min(hamming_distance(seq, reverse_complement(e)) for e in indices)
            )
        if min_dist >= MIN_HAMMING_DISTANCE:
            indices.append(seq)
    return indices


# =============================================================================
# Hash (与 encoder 完全一致)
# =============================================================================

def generate_valid_hash_codebook(length=8):
    valid = []
    for t in itertools_product(BASES, repeat=length):
        s = ''.join(t)
        gc = gc_content(s)
        if gc < MIN_GC or gc > MAX_GC:
            continue
        if has_homopolymer(s, MAX_HOMOPOLYMER):
            continue
        if s[0] == s[1] or s[-1] == s[-2]:
            continue
        valid.append(s)
    return sorted(valid)

HASH_CODEBOOK = generate_valid_hash_codebook(HASH_LENGTH)
HASH_CODEBOOK_SIZE = len(HASH_CODEBOOK)

def fnv1a_hash_dna(data):
    FNV_PRIME = 0x01000193
    FNV_OFFSET = 0x811c9dc5
    h = FNV_OFFSET
    for c in data:
        h ^= ord(c)
        h = (h * FNV_PRIME) & 0xFFFFFFFF
    return HASH_CODEBOOK[h % HASH_CODEBOOK_SIZE]


# =============================================================================
# Index 纠错查找表
# =============================================================================

def build_error_correction_table(indices):
    """
    预建纠错表: 精确匹配 + 所有 1bp 突变.
    汉明距离 >= 3 保证 1bp 错误唯一纠错.
    """
    table = {}
    for i, seq in enumerate(indices):
        table[seq] = (i, 0)

    for i, seq in enumerate(indices):
        for pos in range(INDEX_LENGTH):
            for base in BASES:
                if base == seq[pos]:
                    continue
                mutant = seq[:pos] + base + seq[pos+1:]
                if mutant not in table:
                    table[mutant] = (i, 1)
                elif table[mutant][0] != i:
                    table[mutant] = (-1, -1)  # 歧义

    return {k: v for k, v in table.items() if v[0] >= 0}


# =============================================================================
# Step 1: PEAR 合并
# =============================================================================

def run_pear_merge(r1_path, r2_path, outdir, min_overlap=80, threads=4):
    """
    调用 PEAR 做双端 read 重叠合并.

    PEAR 穷举所有可能的重叠, 用打分矩阵 + 统计检验选最优.
    不需要预设 fragment size.

    参数:
      min_overlap: 最小重叠长度 (默认 80, 理论重叠 ~110bp)
      threads: 并行线程数

    输出:
      prefix.assembled.fastq   - 合并成功的序列
      prefix.unassembled.forward.fastq - 未合并的 R1
      prefix.unassembled.reverse.fastq - 未合并的 R2
      prefix.discarded.fastq   - 丢弃的
    """
    prefix = os.path.join(outdir, 'pear_merge')

    # 检查 PEAR 是否可用
    if not shutil.which('pear'):
        print("  错误: pear 未找到!")
        print("  安装: conda install -c bioconda pear")
        print("        或从 https://cme.h-its.org/exelixis/web/software/pear/ 下载")
        sys.exit(1)

    cmd = [
        'pear',
        '-f', r1_path,          # forward reads
        '-r', r2_path,          # reverse reads
        '-o', prefix,           # 输出前缀
        '-v', str(min_overlap), # 最小重叠长度
        '-j', str(threads),     # 线程数
        '-p', '0.01',           # p-value 阈值 (统计检验)
    ]

    print(f"  命令: {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(f"  PEAR 错误:")
        print(result.stderr[:1000])
        sys.exit(1)

    # 打印 PEAR 的摘要输出
    for line in result.stdout.split('\n'):
        line = line.strip()
        if any(kw in line.lower() for kw in ['assembled', 'discarded', 'not assembled']):
            print(f"  {line}")

    # PEAR 输出文件
    assembled_path = prefix + '.assembled.fastq'
    if not os.path.exists(assembled_path):
        # 有些版本输出 .assembled.fq
        for ext in ['.assembled.fastq', '.assembled.fq']:
            candidate = prefix + ext
            if os.path.exists(candidate):
                assembled_path = candidate
                break

    if not os.path.exists(assembled_path):
        print(f"  错误: 找不到 PEAR 输出文件")
        print(f"  outdir 内容: {os.listdir(outdir)}")
        sys.exit(1)

    # 统计合并结果
    n_merged = 0
    len_dist = defaultdict(int)
    with open(assembled_path, 'r') as f:
        while True:
            h = f.readline()
            if not h:
                break
            seq = f.readline().strip()
            f.readline()  # +
            f.readline()  # qual
            n_merged += 1
            len_dist[len(seq)] += 1

    print(f"\n  合并成功: {n_merged:,} 条")
    print(f"  长度分布 (top 15):")
    for length, count in sorted(len_dist.items(), key=lambda x: -x[1])[:15]:
        pct = count / n_merged * 100
        bar = '#' * int(pct / 2)
        print(f"    {length:>4}bp: {count:>10,} ({pct:5.1f}%) {bar}")

    # 统计未合并的
    unasm_fwd = prefix + '.unassembled.forward.fastq'
    n_unassembled = 0
    if os.path.exists(unasm_fwd):
        with open(unasm_fwd, 'r') as f:
            for line in f:
                if line.startswith('@'):
                    n_unassembled += 1
    print(f"  未合并:   {n_unassembled:,} 对")

    return assembled_path, n_merged


# =============================================================================
# Step 2: Block ID 滑窗搜索
# =============================================================================

def find_block_ids(seq, ec_table):
    """
    在序列上做 9bp 滑窗, 查找连续两个 index (Block ID + InBlock ID).
    Block ID 在 oligo 位置 20 开始, 所以找到位置 p 意味着:
      seq[p] 对应 oligo 位置 20
      seq 的起始 (位置 0) 对应 oligo 位置 20 - p

    返回: (anchor_pos, block_id, inblock_id, block_err, inblock_err) 或 None
      anchor_pos: seq 中 Block ID 起始位置
    """
    if len(seq) < 18:
        return None

    results = []
    for p in range(len(seq) - 17):
        seg1 = seq[p:p+9]
        seg2 = seq[p+9:p+18]

        if seg1 not in ec_table or seg2 not in ec_table:
            continue

        bid, berr = ec_table[seg1]
        iid, ierr = ec_table[seg2]
        total_err = berr + ierr
        results.append((total_err, p, bid, iid, berr, ierr))

    if not results:
        return None

    # 取纠错数最少的; 同分取最靠近理论位置 20 的
    results.sort(key=lambda x: (x[0], abs(x[1] - 20)))
    _, anchor, bid, iid, berr, ierr = results[0]
    return (anchor, bid, iid, berr, ierr)


# =============================================================================
# 字段提取与 Hash 校验
# =============================================================================

def extract_field(seq, anchor_pos, field_start, field_end):
    """
    从序列中提取 oligo 上 [field_start, field_end) 的字段.
    anchor_pos: seq 中 Block ID 起始位置, 对应 oligo 位置 20.
    """
    # seq[anchor_pos] = oligo[20]
    # seq[i] = oligo[20 + (i - anchor_pos)]
    # 要取 oligo[field_start] → seq[anchor_pos + (field_start - 20)]
    seq_start = anchor_pos + (field_start - 20)
    seq_end = anchor_pos + (field_end - 20)

    if seq_start < 0 or seq_end > len(seq):
        return None

    field = seq[seq_start:seq_end]
    if 'N' in field:
        return None
    return field


def verify_hash(seq, anchor_pos):
    """提取 Block ID + InBlock ID + Payload, 计算 hash, 与 hash 字段比较."""
    block_seq = extract_field(seq, anchor_pos, 20, 29)
    inblock_seq = extract_field(seq, anchor_pos, 29, 38)
    payload = extract_field(seq, anchor_pos, 38, 162)
    hash_field = extract_field(seq, anchor_pos, 162, 170)

    if not all([block_seq, inblock_seq, payload, hash_field]):
        return False, None

    expected = fnv1a_hash_dna(block_seq + inblock_seq + payload)
    return expected == hash_field, payload


# =============================================================================
# FASTQ 读取
# =============================================================================

def read_fastq(path):
    """逐条读取 FASTQ"""
    open_func = gzip.open if path.endswith('.gz') else open
    mode = 'rt' if path.endswith('.gz') else 'r'
    with open_func(path, mode) as f:
        while True:
            header = f.readline().strip()
            if not header:
                break
            seq = f.readline().strip()
            f.readline()  # +
            qual = f.readline().strip()
            yield header, seq, qual


# =============================================================================
# 主处理流程
# =============================================================================

def process_merged_reads(merged_path, indices, ec_table, primer_tails,
                         max_block_id=100):
    """
    v5: 处理合并后的序列, 用 4 元组分组计数.
      Block ID 搜索 → primer 归属 → hash 校验 → 按 (bid, iid, primer_id) 桶 +
      4 元组 (read_block, read_inblock, read_payload, read_hash) 分组计数

    返回:
      stats: 统计字典
      bucket_counter: dict[(bid, iid, primer_id)] -> Counter({tuple4: count})
        其中 tuple4 = (read_block, read_inblock, read_payload, read_hash)
    """

    n_primers = len(primer_tails)

    stats = {
        'total': 0,
        'id_found': 0,
        'id_not_found': 0,
        'bid_filtered': 0,
        'hash_pass': 0,
        'hash_fail': 0,
        'hash_incomplete': 0,
        'block_err_dist': Counter(),
        'inblock_err_dist': Counter(),
        'seq_len_dist': Counter(),
        'primer_id_dist': Counter(),
        'primer_id_dist_hashpass': Counter(),
        'short_anchor_count': 0,
    }

    # (bid, iid, primer_id) -> Counter({tuple4: count})
    bucket_counter = defaultdict(Counter)

    print(f"\n[Step 2] Block ID 滑窗搜索 + primer 归属 + Hash 校验 + 4 元组分组")
    print(f"  primer_tails: {n_primers} 条")
    print(f"  max_block_id: {max_block_id}  (bid >= 此值的 reads 直接丢弃)")

    for header, seq, qual in read_fastq(merged_path):
        stats['total'] += 1
        stats['seq_len_dist'][len(seq)] += 1

        if stats['total'] % 500000 == 0:
            print(f"    已处理 {stats['total']:,}, "
                  f"ID命中 {stats['id_found']:,}, "
                  f"Hash通过 {stats['hash_pass']:,}, "
                  f"桶数 {len(bucket_counter):,}")

        # 正向搜索
        result = find_block_ids(seq, ec_table)
        if result is None:
            rc_seq = reverse_complement(seq)
            result = find_block_ids(rc_seq, ec_table)
            if result is not None:
                seq = rc_seq

        if result is None:
            stats['id_not_found'] += 1
            continue

        stats['id_found'] += 1
        anchor_pos, block_id, inblock_id, berr, ierr = result

        if max_block_id is not None and block_id >= max_block_id:
            stats['bid_filtered'] += 1
            continue

        stats['block_err_dist'][berr] += 1
        stats['inblock_err_dist'][ierr] += 1

        if anchor_pos < PRIMER_TAIL_N:
            stats['short_anchor_count'] += 1
        primer_id = assign_primer_id(seq, anchor_pos, primer_tails)
        stats['primer_id_dist'][primer_id] += 1

        # Hash 校验
        hash_ok, payload = verify_hash(seq, anchor_pos)

        if payload is None:
            stats['hash_incomplete'] += 1
            continue
        if not hash_ok:
            stats['hash_fail'] += 1
            continue

        # hash 通过: 提取 4 元组并计数
        stats['hash_pass'] += 1
        stats['primer_id_dist_hashpass'][primer_id] += 1

        read_block = seq[anchor_pos : anchor_pos + 9]
        read_inblock = seq[anchor_pos + 9 : anchor_pos + 18]
        read_hash = seq[anchor_pos + 142 : anchor_pos + 150]
        # read_payload 与 verify_hash 提取的一致 (但用 seq 切出确保一致)
        read_payload = seq[anchor_pos + 18 : anchor_pos + 142]

        key = (block_id, inblock_id, primer_id)
        tuple4 = (read_block, read_inblock, read_payload, read_hash)
        bucket_counter[key][tuple4] += 1

    return stats, bucket_counter

# =============================================================================
# Step 3: 选主导库 + 应用 K 阈值 + 输出 final 产物
# =============================================================================

def select_dominant_primer(stats, primers):
    """根据 primer_id 分布选主导库 (reads 数最多的 primer)."""
    n_primers = len(primers)
    primer_dist = sorted(
        [(pid, stats['primer_id_dist'].get(pid, 0)) for pid in range(n_primers)],
        key=lambda x: -x[1])
    return primer_dist[0][0], primer_dist


def apply_k_threshold(bucket_counter, dominant_pid, K):
    """
    在主导库桶上应用 K 阈值, 选 winner.

    对每个 (bid, iid, primer_id == dominant_pid) 桶:
      取频次最高的 4 元组作为 winner candidate, 频次 = coverage.
      只接受 coverage >= K 的桶.

    返回:
      final_payloads: dict[(bid, iid)] -> {
        'payload': ...,           # winner 的 payload (124bp)
        'coverage': int,          # winner 4 元组的频次
        'total_reads': int,       # 该桶所有 hash-pass reads 总数
        'n_distinct_tuples': int, # 该桶有几个不同的 4 元组
        'read_block': ..., 'read_inblock': ..., 'read_hash': ...
      }
      n_below_k: 因为 coverage < K 被丢弃的桶数
      n_other_primers_buckets: 非主导库桶数 (统计用)
    """
    final_payloads = {}
    n_below_k = 0
    n_other_primers_buckets = 0
    coverage_dist = Counter()  # winner 覆盖度分布

    for key, counter in bucket_counter.items():
        bid, iid, pid = key
        if pid != dominant_pid:
            n_other_primers_buckets += 1
            continue

        most_common = counter.most_common(1)[0]
        winner_tuple, coverage = most_common
        total_reads = sum(counter.values())
        n_distinct = len(counter)

        coverage_dist[coverage] += 1

        if coverage < K:
            n_below_k += 1
            continue

        rb, ri, rp, rh = winner_tuple
        final_payloads[(bid, iid)] = {
            'payload': rp,
            'coverage': coverage,
            'total_reads': total_reads,
            'n_distinct_tuples': n_distinct,
            'read_block': rb,
            'read_inblock': ri,
            'read_hash': rh,
        }

    return final_payloads, n_below_k, n_other_primers_buckets, coverage_dist


def write_outputs(outdir, stats, final_payloads, indices, dominant_pid,
                  primers, K, n_below_k, n_other_primers_buckets, coverage_dist):
    """
    v5: 写主导库恢复产物 + 详细报告.
    """
    os.makedirs(outdir, exist_ok=True)

    # --- 主报告 ---
    rpt_path = os.path.join(outdir, 'recovery_report.txt')
    with open(rpt_path, 'w') as f:
        f.write("DNA Storage Recovery Report (v5)\n")
        f.write("4 元组多数投票 + K 阈值过滤 (无聚类, 无 CAPMB)\n")
        f.write("=" * 60 + "\n\n")
        f.write(f"合并后序列总数:       {stats['total']:>12,}\n")
        f.write(f"ID 命中:              {stats['id_found']:>12,} "
                f"({stats['id_found']/max(stats['total'],1)*100:.1f}%)\n")
        f.write(f"ID 未命中:            {stats['id_not_found']:>12,}\n")
        f.write(f"bid 过滤 (>= 100):    {stats.get('bid_filtered',0):>12,}\n")
        f.write(f"锚点前不足{PRIMER_TAIL_N}bp:    {stats['short_anchor_count']:>12,}\n\n")
        f.write(f"hash 通过 (单条):     {stats['hash_pass']:>12,}\n")
        f.write(f"hash 失败:            {stats['hash_fail']:>12,}\n")
        f.write(f"字段不完整:           {stats['hash_incomplete']:>12,}\n\n")

        f.write("primer_id 分布 (所有 ID 命中 reads, 用于选主导库):\n")
        n_primers = len(primers)
        for pid in range(n_primers):
            cnt = stats['primer_id_dist'].get(pid, 0)
            cnt_h = stats['primer_id_dist_hashpass'].get(pid, 0)
            pct = cnt / max(stats['id_found'], 1) * 100
            mark = "  ← 主导库" if pid == dominant_pid else ""
            primer_str = primers[pid][:20]
            f.write(f"  #{pid} ({primer_str}): {cnt:,} ({pct:.1f}%)   "
                    f"hash 通过 {cnt_h:,}{mark}\n")

        f.write(f"\n--- 主导库 (primer_id={dominant_pid}) ---\n")
        f.write(f"非主导库桶数 (已丢弃):     {n_other_primers_buckets:>10,}\n")
        f.write(f"主导库 winner 覆盖度分布:\n")
        cum = 0
        cum_below_k = 0
        for c in sorted(coverage_dist.keys()):
            cum += coverage_dist[c]
            mark = "  ← 被 K 阈值丢弃" if c < K else ""
            if c < K:
                cum_below_k += coverage_dist[c]
            f.write(f"    coverage={c:>3}: {coverage_dist[c]:>8,}  累计 {cum:>8,}{mark}\n")

        n_total_buckets = sum(coverage_dist.values())
        f.write(f"\n  主导库桶总数:         {n_total_buckets:>10,}\n")
        f.write(f"  K = {K} 阈值丢弃:        {n_below_k:>10,} "
                f"({n_below_k/max(n_total_buckets,1)*100:.2f}%)\n")
        f.write(f"  K = {K} 阈值通过:        {len(final_payloads):>10,} "
                f"({len(final_payloads)/max(n_total_buckets,1)*100:.2f}%)\n")

        f.write(f"\nBlock ID 纠错距离 (主导库 reads):\n")
        for d in sorted(stats['block_err_dist'].keys()):
            f.write(f"  距离{d}: {stats['block_err_dist'][d]:,}\n")
        f.write(f"\nInBlock ID 纠错距离:\n")
        for d in sorted(stats['inblock_err_dist'].keys()):
            f.write(f"  距离{d}: {stats['inblock_err_dist'][d]:,}\n")

        f.write(f"\n合并后序列长度分布 (top 15):\n")
        for length, count in sorted(stats['seq_len_dist'].items(),
                                     key=lambda x: -x[1])[:15]:
            f.write(f"  {length}bp: {count:,} "
                    f"({count/max(stats['total'],1)*100:.1f}%)\n")

    print(f"  报告: {rpt_path}")

    # --- 控制台简要输出 ---
    n_total_buckets = sum(coverage_dist.values())
    print(f"\n[Step 3] 应用 K={K} 阈值")
    print(f"  主导库桶总数:    {n_total_buckets:,}")
    print(f"  K 阈值丢弃:      {n_below_k:,} (coverage < {K})")
    print(f"  最终接受:        {len(final_payloads):,}")

    # --- 输出 final payloads (供下游 Raptor-Q) ---
    payload_path = os.path.join(outdir, 'recovered_payloads.tsv')
    with open(payload_path, 'w', newline='') as f:
        w = csv.writer(f, delimiter='\t')
        w.writerow(['block_id', 'inblock_id', 'global_idx',
                    'coverage', 'total_reads', 'n_distinct_tuples',
                    'payload'])
        for addr in sorted(final_payloads.keys()):
            bid, iid = addr
            info = final_payloads[addr]
            global_idx = bid * len(indices) + iid
            w.writerow([bid, iid, global_idx,
                        info['coverage'], info['total_reads'],
                        info['n_distinct_tuples'], info['payload']])
    print(f"  Payloads: {payload_path}")

    return len(final_payloads)


def load_oligo_table(oligo_csv, primer_fwd, primer_rev):
    """加载 oligo 总表, 返回目标引物组的序列列表."""
    print(f"\n[加载参考总表] {oligo_csv}")
    oligos = []
    with open(oligo_csv) as f:
        for row in csv.reader(f):
            if row:
                seq = row[0].strip().upper()
                if seq and len(seq) > 50 and set(seq) <= {'A', 'T', 'G', 'C'}:
                    oligos.append(seq)
    print(f"  总行数: {len(oligos):,}")

    # 按引物分组
    target = []
    for seq in oligos:
        if len(seq) >= 40:
            if seq[:20] == primer_fwd and seq[-20:] == primer_rev:
                target.append(seq)

    # 去重
    target_unique = list(dict.fromkeys(target))
    print(f"  目标引物组: {len(target_unique):,} 条 unique oligos")
    return target_unique


def load_encoder_fasta(fasta_path):
    """
    v5.1 新增: 加载 encoder 当年输出的原始 oligos.fasta.

    fasta 文件中每条 oligo 的 header 格式 (encoder 写的):
      >block{bid}_inblock{iid}_idx{payload_idx}_{type}
    其中 type ∈ {'main', 'meta_a', 'meta_b'} (默认 'data')

    fasta 文件的写入顺序就是 payload_idx 顺序 (encoder 单调递增).

    返回:
      list of dict: [{'block_id': int, 'inblock_id': int, 'payload_idx': int,
                      'type': str, 'oligo': str (190nt)}, ...]
      列表顺序就是 payload_idx 顺序
    """
    import re
    print(f"\n[加载 encoder fasta] {fasta_path}")
    entries = []

    header_re = re.compile(
        r'^>block(\d+)_inblock(\d+)_idx(\d+)_(\w+)')

    with open(fasta_path) as f:
        cur_header = None
        cur_seq = []
        for line in f:
            line = line.strip()
            if not line:
                continue
            if line.startswith('>'):
                # commit previous
                if cur_header is not None:
                    seq = ''.join(cur_seq).upper()
                    m = header_re.match(cur_header)
                    if m:
                        bid, iid, pidx, ptype = m.groups()
                        entries.append({
                            'block_id': int(bid),
                            'inblock_id': int(iid),
                            'payload_idx': int(pidx),
                            'type': ptype,
                            'oligo': seq,
                        })
                cur_header = line
                cur_seq = []
            else:
                cur_seq.append(line)
        # last
        if cur_header is not None:
            seq = ''.join(cur_seq).upper()
            m = header_re.match(cur_header)
            if m:
                bid, iid, pidx, ptype = m.groups()
                entries.append({
                    'block_id': int(bid),
                    'inblock_id': int(iid),
                    'payload_idx': int(pidx),
                    'type': ptype,
                    'oligo': seq,
                })

    print(f"  共 {len(entries):,} 条")
    # 类型分布
    type_counts = Counter(e['type'] for e in entries)
    for t, c in sorted(type_counts.items()):
        print(f"    type={t}: {c:,}")

    return entries




# =============================================================================
# Step 4: 主导库评估 (核心交付: 未恢复 + 错误进入两类统计)
# =============================================================================

def evaluate_dominant_library(final_payloads, indices, ec_table, ref_entries,
                               outdir, dominant_pid, primer_label="",
                               params=None):
    """
    v5.1: 评估层. 输入改为 ref_entries (encoder fasta 解析的 list of dict).

    每个 ref_entry 含: block_id, inblock_id, payload_idx, type, oligo (190nt)
    list 顺序 = encoder 原始输出顺序 = 真实 payload_idx 顺序.

    评估:
      (1) 未恢复率: 总表里有多少 (bid, iid) 没被恢复出来
      (2) 错误进入率: 恢复出的中有多少是错的, 分两类:
          (A) error_addr_not_in_ref: 地址不在主导库总表
          (B) error_payload_mismatch: 地址在总表但 payload 不一致
              ★ 最危险, 是 Raptor-Q silent corruption 的来源
    """
    print(f"\n[Step 4] 主导库评估  primer_id={dominant_pid}  ({primer_label[:20]})")
    print(f"  恢复层不知道总表存在; 此处仅统计.")

    # ---- 从 encoder fasta entries 提取 (bid, iid) -> ref_payload + payload_idx + type ----
    ref_by_addr = {}      # (bid, iid) -> ref_payload (124nt)
    ref_addr_to_pidx = {} # (bid, iid) -> 真实 payload_idx (来自 fasta header)
    ref_addr_to_type = {} # (bid, iid) -> 类型 (main/meta_a/meta_b)

    for entry in ref_entries:
        seq = entry['oligo']
        if len(seq) < 162:
            continue
        bid = entry['block_id']
        iid = entry['inblock_id']
        ref_payload = seq[38:162]
        addr = (bid, iid)
        if addr not in ref_by_addr:
            ref_by_addr[addr] = ref_payload
            ref_addr_to_pidx[addr] = entry['payload_idx']
            ref_addr_to_type[addr] = entry['type']

    print(f"  encoder fasta entries: {len(ref_entries):,}")
    print(f"  成功提取地址:         {len(ref_by_addr):,}")

    ref_addrs = set(ref_by_addr.keys())

    # ---- 提取恢复层产物 (v5: 直接从 final_payloads 取) ----
    recovered = {addr: info['payload'] for addr, info in final_payloads.items()}
    recovered_addrs = set(recovered.keys())

    print(f"  恢复层产物 (K 阈值通过): {len(recovered_addrs):,}")

    # ---- 评估 (1): 未恢复 ----
    missing_addrs = ref_addrs - recovered_addrs
    coverage_pct = (len(ref_addrs) - len(missing_addrs)) / max(len(ref_addrs), 1) * 100

    # ---- 评估 (2): 错误进入 ----
    n_correct = 0                     # hash ok + 在总表 + payload 一致 (正确恢复)
    n_err_addr_not_in_ref = 0         # (A) hash ok 但地址不在总表
    n_err_payload_mismatch = 0        # (B) hash ok 且地址在总表但 payload 不一致

    err_addr_not_in_ref_list = []     # [(bid, iid, payload), ...]
    err_payload_mismatch_list = []    # [(bid, iid, recovered_payload, ref_payload), ...]
    correct_list = []                 # [(bid, iid), ...]

    for addr, recov_payload in recovered.items():
        bid, iid = addr
        if addr not in ref_addrs:
            n_err_addr_not_in_ref += 1
            err_addr_not_in_ref_list.append((bid, iid, recov_payload))
        else:
            ref_payload = ref_by_addr[addr]
            if recov_payload == ref_payload:
                n_correct += 1
                correct_list.append(addr)
            else:
                n_err_payload_mismatch += 1
                err_payload_mismatch_list.append((bid, iid, recov_payload, ref_payload))

    n_recovered = len(recovered_addrs)
    n_total_err = n_err_addr_not_in_ref + n_err_payload_mismatch

    # ---- 打印结果 ----
    print(f"\n 主导库恢复评估")
    print(f"  总表大小 (期望恢复):   {len(ref_addrs):>10,}")
    print(f"  恢复层产物 (hash ok):  {n_recovered:>10,}")
    print(f"  ─" * 30)
    print(f"  正确恢复:              {n_correct:>10,} "
          f"({n_correct/max(len(ref_addrs),1)*100:.2f}% of 总表)")
    print(f"  未恢复 (总表中无产物): {len(missing_addrs):>10,} "
          f"({len(missing_addrs)/max(len(ref_addrs),1)*100:.2f}% of 总表)")
    print(f"  ─" * 30)
    print(f"   错误进入事件 (恢复出的 hash-ok 中):")
    print(f"     (A) 地址不在总表:    {n_err_addr_not_in_ref:>10,} "
          f"({n_err_addr_not_in_ref/max(n_recovered,1)*100:.4f}% of 恢复层)")
    print(f"     (B) payload 不一致:  {n_err_payload_mismatch:>10,} "
          f"({n_err_payload_mismatch/max(n_recovered,1)*100:.4f}% of 恢复层)")
    print(f"     合计错误进入率:      {n_total_err/max(n_recovered,1)*100:.4f}%")

    # ---- 写出评估报告 ----
    tag = primer_label[:10] if primer_label else f"pid{dominant_pid}"
    eval_path = os.path.join(outdir, f'evaluation_{tag}.txt')
    with open(eval_path, 'w') as f:
        f.write("Dominant Library Evaluation Report\n")
        f.write(f"primer_id = {dominant_pid}\n")
        f.write(f"primer    = {primer_label}\n")
        f.write("=" * 60 + "\n\n")
        f.write(f"主导库总表大小:        {len(ref_addrs):>10,}\n")
        f.write(f"恢复层产物 (hash ok):  {n_recovered:>10,}\n\n")
        f.write(f"--- 与总表比对 ---\n")
        f.write(f"正确恢复:              {n_correct:>10,} "
                f"({n_correct/max(len(ref_addrs),1)*100:.2f}%)\n")
        f.write(f"未恢复:                {len(missing_addrs):>10,} "
                f"({len(missing_addrs)/max(len(ref_addrs),1)*100:.2f}%)\n\n")
        f.write(f"--- 错误进入事件 (核心) ---\n")
        f.write(f"(A) 地址不在总表:      {n_err_addr_not_in_ref:>10,} "
                f"({n_err_addr_not_in_ref/max(n_recovered,1)*100:.4f}%)\n")
        f.write(f"(B) payload 不一致:    {n_err_payload_mismatch:>10,} "
                f"({n_err_payload_mismatch/max(n_recovered,1)*100:.4f}%)\n")
        f.write(f"    ★ (B) 是最危险的: hash 和 index 都通过但 payload 错了\n")
        f.write(f"合计错误进入率:        "
                f"{n_total_err/max(n_recovered,1)*100:.4f}% of 恢复层\n\n")

        # v5.1: 直接用 fasta header 里的 type, 不需要 params 推断
        # type ∈ {'main', 'meta_a', 'meta_b'}; main 内部进一步用 params 区分 core / meta_in_main
        coredata_len = int(params.get('coredata_length', 0)) if params else 0
        payload_len_param = int(params.get('payload_length', 124)) if params else 124
        coredata_payloads = (coredata_len + payload_len_param - 1) // payload_len_param if coredata_len > 0 else 0

        type_total = Counter()
        type_correct = Counter()
        type_missing = Counter()
        for addr, fasta_type in ref_addr_to_type.items():
            pidx = ref_addr_to_pidx[addr]
            # main 进一步细分: core / meta_in_main
            if fasta_type == 'main':
                if pidx < coredata_payloads:
                    t = 'core'
                else:
                    t = 'meta_in_main'
            else:
                t = fasta_type   # meta_a / meta_b

            type_total[t] += 1
            if addr in recovered_addrs:
                if recovered[addr] == ref_by_addr[addr]:
                    type_correct[t] += 1
            if addr in missing_addrs:
                type_missing[t] += 1

        f.write("--- 按数据类型分类 (来自 encoder fasta header) ---\n")
        f.write(f"  {'类型':<14} {'总数':>8} {'正确恢复':>10} {'未恢复':>8}  比率\n")
        for t in ['core', 'meta_in_main', 'meta_a', 'meta_b']:
            if type_total[t] == 0:
                continue
            pct = type_correct[t] / max(type_total[t], 1) * 100
            f.write(f"  {t:<14} {type_total[t]:>8,} {type_correct[t]:>10,} "
                    f"{type_missing[t]:>8,}  {pct:.2f}%\n")
        f.write("\n")

    print(f"\n  评估报告: {eval_path}")

    # ---- 写出未恢复列表 ----
    # v5.1: 反查 encoder fasta 拿原始 oligo
    addr_to_oligo = {(e['block_id'], e['inblock_id']): e['oligo'] for e in ref_entries}
    missing_path = os.path.join(outdir, f'missing_oligos_{tag}.tsv')
    with open(missing_path, 'w', newline='') as f:
        w = csv.writer(f, delimiter='\t')
        w.writerow(['block_id', 'inblock_id', 'global_idx',
                    'payload_idx', 'type', 'ref_full_oligo'])
        for addr in sorted(missing_addrs):
            bid, iid = addr
            pidx = ref_addr_to_pidx.get(addr, -1)
            ftype = ref_addr_to_type.get(addr, '')
            ref_seq = addr_to_oligo.get(addr, '')
            w.writerow([bid, iid, bid * len(indices) + iid, pidx, ftype, ref_seq])
    print(f"  未恢复列表: {missing_path}  (含完整参考 oligo)")

    # ---- 写出错误进入明细 ----
    err_path = os.path.join(outdir, f'error_entries_{tag}.tsv')
    with open(err_path, 'w', newline='') as f:
        w = csv.writer(f, delimiter='\t')
        w.writerow(['error_type', 'block_id', 'inblock_id', 'global_idx',
                    'recovered_payload', 'ref_payload', 'payload_diff_bp'])
        for bid, iid, payload in err_addr_not_in_ref_list:
            w.writerow(['addr_not_in_ref', bid, iid,
                        bid * len(indices) + iid, payload, '', 'N/A'])
        for bid, iid, recov, ref in err_payload_mismatch_list:
            diff = sum(c1 != c2 for c1, c2 in zip(recov, ref))
            w.writerow(['payload_mismatch', bid, iid,
                        bid * len(indices) + iid, recov, ref, diff])
    print(f"  错误进入明细: {err_path}")
    if n_err_payload_mismatch > 0:
        print(f"     ★ 请人工检查 payload_mismatch 条目")

    return {
        'n_ref': len(ref_addrs),
        'n_recovered': n_recovered,
        'n_correct': n_correct,
        'n_missing': len(missing_addrs),
        'n_err_addr_not_in_ref': n_err_addr_not_in_ref,
        'n_err_payload_mismatch': n_err_payload_mismatch,
        'coverage_pct': coverage_pct,
        'error_pct': n_total_err / max(n_recovered, 1) * 100,
    }



