"""
DNA Storage Encoder - 编码器

功能：将 metadata、coredata 和 meta-metadata 编码为 oligo 池

数据结构：
  1. Coredata + Metadata 拼接，补齐到 124 的倍数，切分为 payload
  2. Meta-metadata A 组：每条 124 nt，直接作为 payload
  3. Meta-metadata B 组：每条 124 nt，直接作为 payload

编码顺序：
  [Coredata+Metadata payloads] → [Meta-A payloads] → [Meta-B payloads]

使用方法：
  python dna_storage_encoder_v4.py -m metadata.txt -c coredata.txt -a A_out.fasta -b B_out.fasta -o oligos.fasta

结构 (190 nt):
  引物(20) + Block ID(9) + InBlock ID(9) + Payload(124) + Hash(8) + 引物(20)
"""

import random
import argparse
from itertools import product
from typing import List, Dict, Tuple
from tqdm import tqdm


# =============================================================================
# 共享配置参数（编码器和解码器必须一致）
# =============================================================================

INDEX_LENGTH = 9
PAYLOAD_LENGTH = 124
HASH_LENGTH = 8
PRIMER_LENGTH = 20
OLIGO_LENGTH = 190

MIN_GC = 0.40
MAX_GC = 0.60
OPTIMAL_GC = 0.50
MAX_HOMOPOLYMER = 3
MIN_HAMMING_DISTANCE = 3

# 默认随机种子（编码器和解码器共享）
DEFAULT_SEED = 20241222

# 默认引物
DEFAULT_FORWARD_PRIMER = 'TGTGTTCCTCCTCGGTATGA'
DEFAULT_REVERSE_PRIMER = 'ACAATTAGTTGGCGCTTCCT'

BASES = ['A', 'T', 'G', 'C']


# =============================================================================
# 基础函数
# =============================================================================

def gc_content(seq: str) -> float:
    """计算GC含量"""
    if len(seq) == 0:
        return 0
    return sum(1 for b in seq if b in 'GC') / len(seq)


def gc_score(seq: str) -> float:
    """GC得分，50%最高"""
    gc = gc_content(seq)
    return 1.0 - abs(gc - OPTIMAL_GC) * 2


def has_homopolymer(seq: str, max_len: int) -> bool:
    """检查是否有超过max_len的连续相同碱基"""
    for base in BASES:
        if base * (max_len + 1) in seq:
            return True
    return False


def count_max_homopolymer(seq: str) -> int:
    """返回最长同聚物长度"""
    if len(seq) == 0:
        return 0
    max_len = 1
    current_len = 1
    for i in range(1, len(seq)):
        if seq[i] == seq[i-1]:
            current_len += 1
            max_len = max(max_len, current_len)
        else:
            current_len = 1
    return max_len


def hamming_distance(seq1: str, seq2: str) -> int:
    """计算汉明距离"""
    return sum(c1 != c2 for c1, c2 in zip(seq1, seq2))


def reverse_complement(seq: str) -> str:
    """反向互补"""
    comp = {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}
    return ''.join(comp[b] for b in reversed(seq))


def check_junction(seq1: str, seq2: str, max_homo: int = MAX_HOMOPOLYMER) -> bool:
    """检查两个序列连接处是否满足同聚物约束"""
    junction = seq1[-4:] + seq2[:4]
    return not has_homopolymer(junction, max_homo)


def generate_random_padding(length: int, prev_base: str = None, seed: int = None) -> str:
    """
    生成随机填充序列，满足 GC 和 homopolymer 约束
    
    Args:
        length: 需要生成的长度
        prev_base: 前一个碱基（用于避免连接处 homopolymer）
        seed: 随机种子
    """
    if seed is not None:
        random.seed(seed)
    
    padding = []
    last_base = prev_base
    consecutive = 1 if prev_base else 0
    
    # 目标 GC 含量
    target_gc = 0.50
    gc_count = 0
    
    for i in range(length):
        # 计算当前需要的 GC 比例
        remaining = length - i
        current_gc = gc_count / (i + 1) if i > 0 else 0.5
        
        # 根据当前 GC 调整选择概率
        if current_gc < target_gc - 0.1:
            # 需要更多 GC
            candidates = ['G', 'C', 'G', 'C', 'A', 'T']
        elif current_gc > target_gc + 0.1:
            # 需要更多 AT
            candidates = ['A', 'T', 'A', 'T', 'G', 'C']
        else:
            candidates = BASES
        
        # 避免 homopolymer
        valid_bases = []
        for base in candidates:
            if last_base == base:
                if consecutive < MAX_HOMOPOLYMER:
                    valid_bases.append(base)
            else:
                valid_bases.append(base)
        
        if not valid_bases:
            valid_bases = [b for b in BASES if b != last_base]
        
        chosen = random.choice(valid_bases)
        padding.append(chosen)
        
        if chosen in 'GC':
            gc_count += 1
        
        if chosen == last_base:
            consecutive += 1
        else:
            consecutive = 1
        last_base = chosen
    
    return ''.join(padding)


# =============================================================================
# 约束感知哈希
# =============================================================================

def generate_valid_hash_codebook(length: int = 8) -> List[str]:
    """生成满足约束的哈希码本"""
    valid_seqs = []
    
    for seq_tuple in product(BASES, repeat=length):
        seq = ''.join(seq_tuple)
        
        gc = gc_content(seq)
        if gc < MIN_GC or gc > MAX_GC:
            continue
        
        if has_homopolymer(seq, MAX_HOMOPOLYMER):
            continue
        
        if seq[0] == seq[1]:
            continue
        
        if seq[-1] == seq[-2]:
            continue
        
        valid_seqs.append(seq)
    
    return sorted(valid_seqs)


HASH_CODEBOOK = generate_valid_hash_codebook(HASH_LENGTH)
HASH_CODEBOOK_SIZE = len(HASH_CODEBOOK)


def fnv1a_hash_dna(data: str) -> str:
    """约束感知的 FNV-1a 哈希"""
    FNV_PRIME = 0x01000193
    FNV_OFFSET = 0x811c9dc5
    
    hash_value = FNV_OFFSET
    for char in data:
        hash_value ^= ord(char)
        hash_value = (hash_value * FNV_PRIME) & 0xFFFFFFFF
    
    index = hash_value % HASH_CODEBOOK_SIZE
    return HASH_CODEBOOK[index]


# =============================================================================
# Index 生成
# =============================================================================

def is_valid_index(seq: str) -> bool:
    """检查单个 Index 是否有效"""
    gc = gc_content(seq)
    if gc < MIN_GC or gc > MAX_GC:
        return False
    if has_homopolymer(seq, MAX_HOMOPOLYMER):
        return False
    return True


def calculate_index_score(seq: str) -> float:
    """计算 Index 质量得分"""
    gc_s = gc_score(seq)
    max_homo = count_max_homopolymer(seq)
    homo_s = 1.0 - (max_homo - 1) / MAX_HOMOPOLYMER
    return gc_s * 0.6 + homo_s * 0.4


def generate_orthogonal_indices(count: int, seed: int) -> List[str]:
    """生成正交的 Index 集合"""
    random.seed(seed)
    print(f"使用随机种子: {seed}")
    
    print("生成候选 Index 池...")
    candidates = []
    attempts = 0
    max_attempts = count * 100
    
    while len(candidates) < count * 10 and attempts < max_attempts:
        attempts += 1
        seq = ''.join(random.choice(BASES) for _ in range(INDEX_LENGTH))
        if is_valid_index(seq):
            score = calculate_index_score(seq)
            candidates.append((seq, score))
    
    print(f"  候选池大小: {len(candidates)}")
    
    candidates.sort(key=lambda x: -x[1])
    
    print("贪心选择正交 Index...")
    indices = []
    
    with tqdm(total=count, desc="选择Index") as pbar:
        for seq, score in candidates:
            if len(indices) >= count:
                break
            
            if len(indices) == 0:
                min_dist = INDEX_LENGTH
            else:
                min_dist = min(
                    min(hamming_distance(seq, existing) for existing in indices),
                    min(hamming_distance(seq, reverse_complement(existing)) for existing in indices)
                )
            
            if min_dist >= MIN_HAMMING_DISTANCE:
                indices.append(seq)
                pbar.update(1)
    
    if len(indices) < count:
        print(f"警告：只生成了 {len(indices)}/{count} 个正交 Index")
    
    print(f"\nIndex 集合统计:")
    gc_values = [gc_content(idx) for idx in indices]
    print(f"  GC 含量: {min(gc_values):.2%} - {max(gc_values):.2%}, 平均 {sum(gc_values)/len(gc_values):.2%}")
    homo_values = [count_max_homopolymer(idx) for idx in indices]
    print(f"  最长同聚物: {min(homo_values)} - {max(homo_values)}")
    
    if len(indices) > 1:
        min_hamming = min(
            hamming_distance(indices[i], indices[j])
            for i in range(len(indices))
            for j in range(i+1, len(indices))
        )
        print(f"  最小汉明距离: {min_hamming}")
    
    return indices


# =============================================================================
# 编码器
# =============================================================================

class DNAStorageEncoder:
    def __init__(self, indices: List[str], forward_primer: str, reverse_primer: str):
        self.indices = indices
        self.forward_primer = forward_primer
        self.reverse_primer = reverse_primer
        self.num_indices = len(indices)
        self.seq_to_idx = {seq: i for i, seq in enumerate(indices)}
    
    def check_block_id(self, block_id: int) -> bool:
        """检查 Block ID 是否与前引物连接处满足约束"""
        block_seq = self.indices[block_id]
        return check_junction(self.forward_primer, block_seq, MAX_HOMOPOLYMER)
    
    def check_all_constraints(self, block_seq: str, inblock_seq: str, 
                               payload: str, hash_seq: str) -> Tuple[bool, str]:
        """检查所有约束"""
        if not check_junction(block_seq, inblock_seq, MAX_HOMOPOLYMER):
            return False, "Block+InBlock"
        
        if not check_junction(inblock_seq, payload, MAX_HOMOPOLYMER):
            return False, "InBlock+Payload"
        
        if not check_junction(payload, hash_seq, MAX_HOMOPOLYMER):
            return False, "Payload+Hash"
        
        if not check_junction(hash_seq, self.reverse_primer, MAX_HOMOPOLYMER):
            return False, "Hash+Primer"
        
        return True, "OK"
    
    def encode_payloads(self, payloads: List[str], payload_types: List[str] = None) -> List[Dict]:
        """
        编码所有 payload
        
        Args:
            payloads: payload 列表
            payload_types: 每个 payload 的类型标记 (可选)
        """
        oligos = []
        
        block_id = 0
        
        skip_stats = {
            "Block+Primer": 0,
            "Block+InBlock": 0,
            "InBlock+Payload": 0,
            "Payload+Hash": 0,
            "Hash+Primer": 0
        }
        imperfect_count = 0
        imperfect_indices = []
        
        print(f"编码: {len(payloads):,} 条 payload")
        
        # 找到第一个有效的 Block ID
        while block_id < self.num_indices:
            if self.check_block_id(block_id):
                break
            skip_stats["Block+Primer"] += 1
            block_id += 1
        
        if block_id >= self.num_indices:
            print("错误：没有有效的 Block ID！")
            return oligos
        
        print(f"  起始 Block ID: {block_id}")
        
        current_inblock_id = 0
        
        for payload_idx, payload in enumerate(tqdm(payloads, desc="编码")):
            
            # 检查是否需要换 Block
            if current_inblock_id >= self.num_indices:
                block_id += 1
                while block_id < self.num_indices and not self.check_block_id(block_id):
                    skip_stats["Block+Primer"] += 1
                    block_id += 1
                current_inblock_id = 0
            
            if block_id >= self.num_indices:
                print(f"错误：Block ID 耗尽！已编码 {len(oligos)} 条")
                break
            
            block_seq = self.indices[block_id]
            
            # 寻找满足约束的 InBlock ID
            found = False
            best_inblock_id = current_inblock_id
            
            test_inblock_id = current_inblock_id
            
            while test_inblock_id < self.num_indices:
                inblock_seq = self.indices[test_inblock_id]
                hash_input = block_seq + inblock_seq + payload
                hash_seq = fnv1a_hash_dna(hash_input)
                
                passed, reason = self.check_all_constraints(
                    block_seq, inblock_seq, payload, hash_seq
                )
                
                if passed:
                    found = True
                    best_inblock_id = test_inblock_id
                    break
                else:
                    skip_stats[reason] = skip_stats.get(reason, 0) + 1
                    test_inblock_id += 1
            
            if not found:
                best_inblock_id = current_inblock_id
                imperfect_count += 1
                imperfect_indices.append(payload_idx)
            
            inblock_seq = self.indices[best_inblock_id]
            hash_input = block_seq + inblock_seq + payload
            hash_seq = fnv1a_hash_dna(hash_input)
            
            oligo = (self.forward_primer + block_seq + inblock_seq + 
                    payload + hash_seq + self.reverse_primer)
            
            oligo_info = {
                'block_id': block_id,
                'block_seq': block_seq,
                'inblock_id': best_inblock_id,
                'inblock_seq': inblock_seq,
                'payload': payload,
                'hash': hash_seq,
                'oligo': oligo,
                'original_index': payload_idx,
                'perfect': found
            }
            
            if payload_types:
                oligo_info['type'] = payload_types[payload_idx]
            
            oligos.append(oligo_info)
            
            current_inblock_id = best_inblock_id + 1
        
        print(f"编码完成: {len(oligos):,} 条 oligo")
        print(f"  完美编码: {len(oligos) - imperfect_count}")
        print(f"  不完美编码（Payload 问题）: {imperfect_count}")
        if imperfect_count > 0 and imperfect_count <= 20:
            print(f"    不完美 Payload 索引: {imperfect_indices}")
        self._print_skip_stats(skip_stats)
        
        return oligos
    
    def _print_skip_stats(self, stats: Dict):
        total = sum(stats.values())
        print(f"  跳过统计 (总计 {total}):")
        for reason, count in stats.items():
            if count > 0:
                print(f"    {reason}: {count}")


# =============================================================================
# 文件操作
# =============================================================================

def read_dna_file(filepath: str) -> str:
    """读取 DNA 文件（支持 FASTA 和纯文本）"""
    sequence = []
    with open(filepath, 'r') as f:
        for line in f:
            line = line.strip()
            if line.startswith('>'):
                continue
            cleaned = ''.join(c.upper() for c in line if c.upper() in 'ATGC')
            sequence.append(cleaned)
    return ''.join(sequence)


def read_meta_metadata(filepath: str) -> List[str]:
    """
    读取 meta-metadata 文件
    每行一条 124 nt 的序列（可能有 FASTA header，也可能没有）
    """
    sequences = []
    with open(filepath, 'r') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('>'):
                continue
            cleaned = ''.join(c.upper() for c in line if c.upper() in 'ATGC')
            if len(cleaned) > 0:
                sequences.append(cleaned)
    return sequences


def split_into_payloads(sequence: str, payload_length: int = PAYLOAD_LENGTH) -> List[str]:
    """将序列切分成 payload（不补齐）"""
    payloads = []
    for i in range(0, len(sequence), payload_length):
        chunk = sequence[i:i+payload_length]
        payloads.append(chunk)
    return payloads


def save_oligos_to_fasta(oligos: List[Dict], output_path: str):
    """保存到 FASTA"""
    with open(output_path, 'w') as f:
        for oligo in oligos:
            ptype = oligo.get('type', 'data')
            header = (f">block{oligo['block_id']}_"
                     f"inblock{oligo['inblock_id']}_idx{oligo['original_index']}_{ptype}")
            f.write(f"{header}\n{oligo['oligo']}\n")
    print(f"已保存 {len(oligos):,} 条 oligo 到 {output_path}")


def save_encoding_table(oligos: List[Dict], output_path: str):
    """保存编码表"""
    with open(output_path, 'w') as f:
        f.write("block_id\tblock_seq\tinblock_id\tinblock_seq\toriginal_index\ttype\thash\tperfect\n")
        for oligo in oligos:
            perfect = oligo.get('perfect', True)
            ptype = oligo.get('type', 'data')
            f.write(f"{oligo['block_id']}\t{oligo['block_seq']}\t"
                   f"{oligo['inblock_id']}\t{oligo['inblock_seq']}\t"
                   f"{oligo['original_index']}\t{ptype}\t{oligo['hash']}\t{perfect}\n")
    print(f"已保存编码表到 {output_path}")


def save_params_file(params: Dict, output_path: str):
    """保存参数文件（解码时需要）"""
    with open(output_path, 'w') as f:
        f.write("# DNA Storage Encoder V4 - 参数文件\n")
        f.write("# 解码时需要此文件\n")
        f.write("#\n")
        for key, value in params.items():
            f.write(f"{key}={value}\n")
    print(f"已保存参数文件到 {output_path}")


