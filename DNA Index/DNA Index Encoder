# 主程序
# =============================================================================

def main():
    parser = argparse.ArgumentParser(
        description='DNA Storage Encoder V4',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
示例:
  python dna_storage_encoder_v4.py -m metadata.txt -c coredata.txt -a A_out.fasta -b B_out.fasta -o oligos.fasta
  python dna_storage_encoder_v4.py -m metadata.txt -c coredata.txt -o oligos.fasta  # 无 meta-metadata

数据结构:
  1. Coredata + Metadata 拼接，补齐到 124 的倍数，切分为 payload
  2. Meta-metadata A 组：每条 124 nt，直接作为 payload
  3. Meta-metadata B 组：每条 124 nt，直接作为 payload

编码顺序: [Coredata+Metadata] → [Meta-A] → [Meta-B]

输出文件:
  oligos.fasta       - Oligo 序列
  oligos_table.txt   - 编码表
  oligos_params.txt  - 参数文件（解码必需）
'''
    )
    
    parser.add_argument('-m', '--metadata', required=True,
                        help='Metadata 文件（FASTA/TXT 格式的 DNA 序列）')
    parser.add_argument('-c', '--coredata', required=True,
                        help='Coredata 文件（FASTA/TXT 格式的 DNA 序列）')
    parser.add_argument('-a', '--meta-a', default=None,
                        help='Meta-metadata A 组文件（每行 124 nt）')
    parser.add_argument('-b', '--meta-b', default=None,
                        help='Meta-metadata B 组文件（每行 124 nt）')
    parser.add_argument('-o', '--output', default='oligos.fasta',
                        help='输出 FASTA 文件（默认: oligos.fasta）')
    parser.add_argument('-n', '--num-indices', type=int, default=500,
                        help='生成的 Index 数量（默认: 500）')
    parser.add_argument('--seed', type=int, default=DEFAULT_SEED,
                        help=f'随机种子（默认: {DEFAULT_SEED}）')
    parser.add_argument('--forward-primer', default=DEFAULT_FORWARD_PRIMER,
                        help=f'前向引物（默认: {DEFAULT_FORWARD_PRIMER}）')
    parser.add_argument('--reverse-primer', default=DEFAULT_REVERSE_PRIMER,
                        help=f'反向引物（默认: {DEFAULT_REVERSE_PRIMER}）')
    
    args = parser.parse_args()
    
    # 验证引物长度
    if len(args.forward_primer) != PRIMER_LENGTH:
        print(f"错误：前向引物长度必须为 {PRIMER_LENGTH} nt，当前为 {len(args.forward_primer)} nt")
        return
    if len(args.reverse_primer) != PRIMER_LENGTH:
        print(f"错误：反向引物长度必须为 {PRIMER_LENGTH} nt，当前为 {len(args.reverse_primer)} nt")
        return
    
    print("=" * 60)
    print("DNA Storage Encoder V4")
    print("=" * 60)
    print(f"随机种子: {args.seed}")
    print(f"Index 数量: {args.num_indices}")
    print(f"前向引物: {args.forward_primer}")
    print(f"反向引物: {args.reverse_primer}")
    print(f"同聚物约束: ≤ {MAX_HOMOPOLYMER}")
    
    # =========================================================================
    # 步骤1：读取 Coredata + Metadata
    # =========================================================================
    print("\n[步骤1] 读取 Coredata + Metadata")
    
    print(f"  Coredata 文件: {args.coredata}")
    coredata_seq = read_dna_file(args.coredata)
    coredata_length = len(coredata_seq)
    print(f"    长度: {coredata_length:,} nt")
    
    print(f"  Metadata 文件: {args.metadata}")
    metadata_seq = read_dna_file(args.metadata)
    metadata_length = len(metadata_seq)
    print(f"    长度: {metadata_length:,} nt")
    
    # 拼接: Coredata + Metadata
    combined_seq = coredata_seq + metadata_seq
    combined_length = len(combined_seq)
    print(f"\n  拼接后长度: {combined_length:,} nt")
    print(f"    Coredata: 0 - {coredata_length-1}")
    print(f"    Metadata: {coredata_length} - {combined_length-1}")
    
    # 计算需要补齐的长度
    remainder = combined_length % PAYLOAD_LENGTH
    if remainder == 0:
        padding_length = 0
    else:
        padding_length = PAYLOAD_LENGTH - remainder
    
    # 生成随机填充序列
    if padding_length > 0:
        print(f"\n  需要补齐: {padding_length} nt")
        last_base = combined_seq[-1] if combined_seq else None
        padding_seq = generate_random_padding(padding_length, last_base, seed=args.seed + 1)
        combined_seq += padding_seq
        print(f"  补齐后长度: {len(combined_seq):,} nt")
        print(f"  填充序列 GC: {gc_content(padding_seq)*100:.1f}%")
        print(f"  填充序列最大同聚物: {count_max_homopolymer(padding_seq)}")
    else:
        padding_seq = ""
        print(f"\n  无需补齐（已是 {PAYLOAD_LENGTH} 的倍数）")
    
    # 切分成 payload
    main_payloads = split_into_payloads(combined_seq, PAYLOAD_LENGTH)
    main_payload_count = len(main_payloads)
    print(f"  切分为 {main_payload_count:,} 条 payload")
    
    # =========================================================================
    # 步骤2：读取 Meta-metadata
    # =========================================================================
    print("\n[步骤2] 读取 Meta-metadata")
    
    meta_a_payloads = []
    meta_b_payloads = []
    
    if args.meta_a:
        print(f"  Meta-A 文件: {args.meta_a}")
        meta_a_payloads = read_meta_metadata(args.meta_a)
        print(f"    读取 {len(meta_a_payloads)} 条序列")
        
        # 验证长度
        invalid_a = [i for i, s in enumerate(meta_a_payloads) if len(s) != PAYLOAD_LENGTH]
        if invalid_a:
            print(f"    ⚠️ 警告: {len(invalid_a)} 条序列长度不是 {PAYLOAD_LENGTH} nt")
            for idx in invalid_a[:5]:
                print(f"      第 {idx+1} 条: {len(meta_a_payloads[idx])} nt")
    else:
        print("  Meta-A: 未提供")
    
    if args.meta_b:
        print(f"  Meta-B 文件: {args.meta_b}")
        meta_b_payloads = read_meta_metadata(args.meta_b)
        print(f"    读取 {len(meta_b_payloads)} 条序列")
        
        # 验证长度
        invalid_b = [i for i, s in enumerate(meta_b_payloads) if len(s) != PAYLOAD_LENGTH]
        if invalid_b:
            print(f"    ⚠️ 警告: {len(invalid_b)} 条序列长度不是 {PAYLOAD_LENGTH} nt")
            for idx in invalid_b[:5]:
                print(f"      第 {idx+1} 条: {len(meta_b_payloads[idx])} nt")
    else:
        print("  Meta-B: 未提供")
    
    # =========================================================================
    # 步骤3：组装所有 payload
    # =========================================================================
    print("\n[步骤3] 组装 Payload")
    
    all_payloads = []
    payload_types = []
    
    # 添加主数据 payload
    for p in main_payloads:
        all_payloads.append(p)
        payload_types.append('main')
    
    # 记录 meta-A 起始位置
    meta_a_start_idx = len(all_payloads)
    
    # 添加 meta-A payload
    for p in meta_a_payloads:
        all_payloads.append(p)
        payload_types.append('meta_a')
    
    # 记录 meta-B 起始位置
    meta_b_start_idx = len(all_payloads)
    
    # 添加 meta-B payload
    for p in meta_b_payloads:
        all_payloads.append(p)
        payload_types.append('meta_b')
    
    total_payload_count = len(all_payloads)
    
    print(f"  总 Payload 数量: {total_payload_count}")
    print(f"    Main (Coredata+Metadata): {main_payload_count} 条 [0-{main_payload_count-1}]")
    if meta_a_payloads:
        print(f"    Meta-A: {len(meta_a_payloads)} 条 [{meta_a_start_idx}-{meta_a_start_idx+len(meta_a_payloads)-1}]")
    if meta_b_payloads:
        print(f"    Meta-B: {len(meta_b_payloads)} 条 [{meta_b_start_idx}-{meta_b_start_idx+len(meta_b_payloads)-1}]")
    
    # =========================================================================
    # 步骤4：生成 Index
    # =========================================================================
    print("\n[步骤4] 生成正交 Index 集合")
    indices = generate_orthogonal_indices(args.num_indices, seed=args.seed)
    
    # =========================================================================
    # 步骤5：编码
    # =========================================================================
    encoder = DNAStorageEncoder(
        indices=indices,
        forward_primer=args.forward_primer,
        reverse_primer=args.reverse_primer
    )
    
    print("\n[步骤5] 编码")
    oligos = encoder.encode_payloads(all_payloads, payload_types)
    
    # =========================================================================
    # 步骤6：保存结果
    # =========================================================================
    print("\n[步骤6] 保存结果")
    
    # 保存 FASTA
    save_oligos_to_fasta(oligos, args.output)
    
    # 保存编码表
    table_path = args.output.replace('.fasta', '_table.txt')
    save_encoding_table(oligos, table_path)
    
    # 保存参数文件
    params_path = args.output.replace('.fasta', '_params.txt')
    params = {
        'seed': args.seed,
        'num_indices': args.num_indices,
        'forward_primer': args.forward_primer,
        'reverse_primer': args.reverse_primer,
        # 数据长度信息
        'coredata_length': coredata_length,
        'metadata_length': metadata_length,
        'padding_length': padding_length,
        'padding_sequence': padding_seq,
        # Payload 信息
        'main_payload_count': main_payload_count,
        'meta_a_count': len(meta_a_payloads),
        'meta_b_count': len(meta_b_payloads),
        'total_payload_count': total_payload_count,
        # 位置信息
        'meta_a_start_idx': meta_a_start_idx,
        'meta_b_start_idx': meta_b_start_idx,
        # 编码信息
        'oligo_count': len(oligos),
        'payload_length': PAYLOAD_LENGTH,
        'index_length': INDEX_LENGTH,
        'hash_length': HASH_LENGTH,
        'hash_codebook_size': HASH_CODEBOOK_SIZE,
        'max_homopolymer': MAX_HOMOPOLYMER,
        'min_hamming_distance': MIN_HAMMING_DISTANCE,
    }
    save_params_file(params, params_path)
    
    # =========================================================================
    # 完成
    # =========================================================================
    print("\n" + "=" * 60)
    print("编码完成！")
    print("=" * 60)
    print(f"\n数据摘要:")
    print(f"  Coredata: {coredata_length:,} nt")
    print(f"  Metadata: {metadata_length:,} nt")
    print(f"  填充: {padding_length} nt")
    print(f"  Meta-A: {len(meta_a_payloads)} 条")
    print(f"  Meta-B: {len(meta_b_payloads)} 条")
    print(f"  总 Oligo: {len(oligos):,} 条")
    print(f"\n输出文件:")
    print(f"  {args.output} - Oligo 序列")
    print(f"  {table_path} - 编码表")
    print(f"  {params_path} - 参数文件（解码必需）")
    print("=" * 60)


if __name__ == "__main__":
    main()
